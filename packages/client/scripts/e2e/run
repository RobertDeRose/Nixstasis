#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"

if [[ -n "${SSL_CERT_FILE:-}" ]]; then
  [[ -f "${SSL_CERT_FILE}" ]] || { echo "SSL_CERT_FILE must name a CA certificate file" >&2; exit 1; }
  export SSL_CERT_FILE="$(cd "$(dirname "${SSL_CERT_FILE}")" && pwd)/$(basename "${SSL_CERT_FILE}")"
fi

cd "${ROOT_DIR}"

host_os="$(uname -s | tr '[:upper:]' '[:lower:]')"
requested_suite=""
requested_journeys=""

source_api_url=""
forwarded_args=()

while (($#)); do
  case "$1" in
    --suite)
      shift
      if (($#)); then
        requested_suite="$1"
        forwarded_args+=(--suite "$1")
        shift
      fi
      ;;
    --suite=*)
      requested_suite="${1#*=}"
      forwarded_args+=("$1")
      shift
      ;;
    --journey)
      shift
      if (($#)); then
        requested_journeys="$1"
        forwarded_args+=(--journey "$1")
        shift
      fi
      ;;
    --journey=*)
      requested_journeys="${1#*=}"
      forwarded_args+=("$1")
      shift
      ;;
    --journeys)
      shift
      if (($#)); then
        requested_journeys="$1"
        forwarded_args+=(--journeys "$1")
        shift
      fi
      ;;
    --journeys=*)
      requested_journeys="${1#*=}"
      forwarded_args+=("$1")
      shift
      ;;
    --api-url)
      shift
      if (($#)); then
        source_api_url="$1"
        shift
      fi
      ;;
    --api-url=*)
      source_api_url="${1#*=}"
      shift
      ;;
    *)
      forwarded_args+=("$1")
      shift
      ;;
  esac
done

needs_linux_runtime="false"
if [[ "${requested_suite}" == "runtime" ]]; then
  needs_linux_runtime="true"
elif [[ "${requested_journeys}" == *"runtime_linux_telemetry"* ]] || [[ "${requested_journeys}" == *"runtime_transport_contract"* ]] || [[ "${requested_journeys}" == *"runtime_transport_negative"* ]]; then
  needs_linux_runtime="true"
fi

if [[ "${host_os}" == "linux" || "${needs_linux_runtime}" != "true" ]]; then
  if [[ -n "${source_api_url}" ]]; then
    forwarded_args+=(--api-url "${source_api_url}")
  fi
  go run ./scripts/e2e "${forwarded_args[@]}"
  exit 0
fi

container_runtime=""
if command -v container >/dev/null 2>&1; then
  container_runtime="container"
elif command -v docker >/dev/null 2>&1; then
  container_runtime="docker"
elif command -v podman >/dev/null 2>&1; then
  container_runtime="podman"
else
  echo "apple container CLI, docker, or podman is required for non-linux runtime E2E execution" >&2
  exit 1
fi

if [[ -z "${source_api_url}" ]]; then
  source_api_url="http://localhost:4000"
fi

default_host_alias="host.docker.internal"
if [[ "${container_runtime}" == "container" ]]; then
  default_host_alias="host.container.internal"
elif [[ "${container_runtime}" == "podman" ]]; then
  default_host_alias="host.containers.internal"
fi
container_host_alias="${E2E_CONTAINER_HOST_ALIAS:-${default_host_alias}}"

container_api_url="${source_api_url}"
# Preserve HTTPS hostnames for certificate verification. Remote HTTP is not
# permitted by the runtime client, even when the E2E loopback opt-in is set.
if [[ "${source_api_url}" == http://* ]]; then
  container_api_url="${container_api_url/localhost/${container_host_alias}}"
  container_api_url="${container_api_url/127.0.0.1/${container_host_alias}}"
  container_api_url="${container_api_url/host.container.internal/${container_host_alias}}"
  container_api_url="${container_api_url/host.docker.internal/${container_host_alias}}"
fi
forwarded_args+=(--api-url "${container_api_url}")

image_tag="docker.io/library/golang:1.27.1-trixie"
container_go_bin="/usr/local/go/bin/go"
runtime_args=(run --rm)
default_cache_root="${TMPDIR:-/tmp}/nixstasis-e2e-go-cache"
cache_root="${E2E_GO_CACHE_DIR:-${default_cache_root}}"
host_gocache="${cache_root}/build"
host_gomodcache="${cache_root}/mod"
container_gocache="/tmp/nixstasis-go-build-cache"
container_gomodcache="/tmp/nixstasis-go-mod-cache"

mkdir -p "${host_gocache}" "${host_gomodcache}"

if [[ "${container_runtime}" == "docker" ]]; then
  runtime_args+=(--add-host "${container_host_alias}:host-gateway")
fi

if [[ -n "${SSL_CERT_FILE:-}" ]]; then
  runtime_args+=(-v "${SSL_CERT_FILE}:/tmp/nixstasis-e2e-ca.pem:ro" -e SSL_CERT_FILE=/tmp/nixstasis-e2e-ca.pem)
fi

"${container_runtime}" "${runtime_args[@]}" \
  -e GOCACHE="${container_gocache}" \
  -e GOMODCACHE="${container_gomodcache}" \
  -v "${host_gocache}:${container_gocache}" \
  -v "${host_gomodcache}:${container_gomodcache}" \
  -v "${ROOT_DIR}:/app" \
  -w /app \
  -e E2E_CONTAINER_PATH_PREFIX="/app" \
  -e E2E_HOST_PATH_PREFIX="${ROOT_DIR}" \
  "${image_tag}" \
  "${container_go_bin}" run ./scripts/e2e "${forwarded_args[@]}"
