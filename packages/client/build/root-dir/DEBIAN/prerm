#!/bin/bash

action=("disable")
[[ -d /run/systemd/system/ ]] && action+=("--now")

systemctl "${action[@]}" nixstasis-registration.service
systemctl "${action[@]}" nixstasis-poll.path

if systemctl is-active nixstasis-poll.service 2> /dev/null; then
  systemctl stop nixstasis-poll.service
fi

if systemctl is-active nixstasis-access.service 2> /dev/null; then
  systemctl stop nixstasis-access.service
fi
