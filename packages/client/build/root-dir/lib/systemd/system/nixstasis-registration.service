[Unit]
Description=Nixstasis Registration
ConditionPathExists=!/etc/nixstasis/id
Requires=network.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nixstasis
Group=nixstasis-ssh
SupplementaryGroups=nixstasis
SyslogIdentifier=nixstasis
ExecStart=/usr/bin/nixstasis register
PrivateTmp=true
Restart=on-failure
RestartSec=120s

[Install]
WantedBy=multi-user.target
