[Unit]
Description=Nixstasis Registration
ConditionPathExists=!/etc/nixstasis/id
Requires=network.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
SyslogIdentifier=nixstasis
ExecStart=/usr/bin/nixstasis register
PrivateTmp=true
Restart=always
RestartSec=120s

[Install]
WantedBy=multi-user.target
