#!/bin/bash
# shellcheck disable=SC1091,SC2034,SC2155
set -eo pipefail

################################################################################
# Run FRP Script
#
# Helper script to launch the FRP client (frpc).
# 1. Resolves device identity.
# 2. Updates Nixstasis with connection details (start/stop hooks).
# 3. Runs frpc with a timeout.
################################################################################

SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")" # Script's directory
source "${SOURCE_DIR}/_api.sh"

INSTALL_DIR="$(realpath "${SOURCE_DIR}/..")"
FRP_CLIENT="/opt/frp/bin/frpc"

if ! NAME="$(get_name)"; then
  log_fatal "Cannot get unique name for device, start remote access"
  exit 1
fi

if ! ID="$(get_id)"; then
  log_fatal "Cannot get id, refusing to start remote access since Nixstasis cannot be updated"
  exit 2
fi

# Hook: Called when tunnel starts
function start() {
  if poll_nixstasis "${ID}" "$(DeviceConnection "${NAME}")"; then
    log_info "Updated connection_string with Nixstasis"
  else
    log_fatal "Unable to update Nixstasis with connection_string"
    exit 1
  fi
}

# Hook: Called when tunnel stops
function stop() {
  if poll_nixstasis "${ID}" "$(DeviceConnection)"; then
    log_info "Removed connection_string from Nixstasis"
  else
    log_fatal "Unable to update Nixstasis with connection_string"
    exit 1
  fi
}

export NAME
# Run FRPC with a 1-hour hard timeout to prevent stale tunnels
/usr/bin/timeout 1h "${FRP_CLIENT}" -c "${INSTALL_DIR}/client.toml" &

pid="$!"

if [[ -z $pid ]]; then
  log_fatal "Unable to start nixstasis-access service"
  exit 1
fi

trap "stop" EXIT INT TERM QUIT

start
# Wait for the process to exit
while pidof frpc &> /dev/null; do sleep 30; done
