#!/bin/bash
# shellcheck disable=SC1091,SC2034,SC2155
set -eo pipefail

################################################################################
# Poll Script
#
# Main polling service for the Nixstasis client.
# 1. Collects local device info (store info, readers, software versions).
# 2. Sends heartbeat to Nixstasis server.
# 3. Checks if server requested remote access.
# 4. Starts/Stops the FRP tunnel accordingly.
################################################################################

SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")" # Script's directory
source "${SOURCE_DIR}/_api.sh"

PAYLOAD_FILE="/var/run/nixstasis/payload"
mkdir -p "$(dirname "$PAYLOAD_FILE")"

if ! NAME="$(get_name)"; then
  log_fatal "Cannot get unique name for device, won't be able to provide remote access"
  exit 3
fi

# Starts the FRP tunnel via systemd
function start_frp() {
  systemd-run --quiet --collect --service-type=simple \
    --unit="nixstasis-access" \
    --working-directory="${INSTALL_DIR}" \
    --setenv=NAME="${NAME}" \
    "${SOURCE_DIR}/run_frp"
}

# Checks if FRP service is active
function frp_running() { systemctl is-active nixstasis-access &> /dev/null; }

# Stops the FRP tunnel
function stop_frp() { frp_running && systemctl stop nixstasis-access; }

# Helper to publish a request to MQTT (mosquitto) and wait for a response
# Used to communicate with other local services (apollo-wirama-driver)
function pub_and_get() {
  local topic="${1}"
  local response

  {
    sleep 1
    mosquitto_pub -t "${topic}" -m '{"type": "get"}'
  } &

  response="$(timeout 3 mosquitto_sub -t "${topic}" -C 2 | jq 'select(.isResponse == true or .isResponse == 1)')"

  [[ "${response}" ]] && echo "${response}" || echo '{}'
}

function main() {
  # 1. Get Store Info from local driver
  if ! store_info="$(pub_and_get "store/info" | jq '{
        account: (.accountNumber // null),
        store: (.storeNumber // null),
        door: (.doorName // null)
      }')"; then
    log_warn "Unable to get store info, apollo-wirama-driver did not respond after 3 seconds"
  fi

  # 2. Get Reader Info from local driver
  if ! readers="$(pub_and_get "Wirama/Devices/enabled" | jq '{
        firmware_version: (.readers[0].expectedFwVersion // null),
        readers: (.readers // []) | map({
          serial_number: .serialNumber,
          position: .displayName,
          profile: .profile,
          tx_band: .txBand,
          region: .region,
          model: .model,
          version: (.fwVersion | sub("FW "; "")),
          status: (if .isOnline then "online" else if .isRebooting then "rebooting" else "offline" end end),
          inventory: (if .autoRunState == "Run" then true else false end),
          finalized: (if .isFinalized == true then true else false end)
        })
      }')"; then
    log_warn "Unable to get readers, apollo-wirama-driver did not respond after 10 seconds"
  fi

  # 3. Construct Payload
  payload="$(
    DeviceUpdate "" "" "" \
      "$(dpkg-query -W -f='${Version}' apollo-wirama-driver 2> /dev/null)" "" "" \
      "$(frp_running && echo "${NAME}" || echo "")"
  )"

  # Merge all info
  payload="$(jq -n "${payload} * ${store_info} * ${readers}")"
  # [[ ! -e $PAYLOAD_FILE ]] && printf '%s\n' "$payload" > "$PAYLOAD_FILE"

  # if diff -q <(jq -S . "$PAYLOAD_FILE") <(jq -S . <<< "$payload") > /dev/null; then
  #   payload='{}'
  # else
  #   printf '%s\n' "$payload" > "$PAYLOAD_FILE"
  # fi

  # 4. Send Heartbeat to Server
  if declare -A response="( $(poll_nixstasis "${ID}" "${payload}" | json2aa) )"; then
    log_info "Polled Nixstasis"

    # 5. Handle Remote Access Request
    if [[ ${response[remote_access_requested]} == "true" ]] && ! frp_running; then
      log_info "Nixstasis is requesting access, starting nixstasis-access"
      if ! start_frp; then
        log_fatal "Failed to start Nixstasis access process"
      fi
    fi
  else
    log_fatal "Unable to connect to Nixstasis"
  fi
}

if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  log_info "Starting Nixstasis polling"

  trap "stop_frp" EXIT INT TERM QUIT

  while true; do
    sleep 5

    # Check for valid registration ID
    unset ID
    if ! ID="$(get_id)"; then
      exit_code="$?"
      log_fatal "Cannot poll Nixstasis (Missing ID)"
      # If missing ID, trigger re-registration service
      systemctl start nixstasis-registration
      exit "$exit_code"
    fi

    main
    sleep 10
  done
fi
