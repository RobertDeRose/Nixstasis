#!/bin/bash
# shellcheck disable=SC1091,SC2034,SC2155
set -eo pipefail

################################################################################
# Register Script
#
# One-time registration script.
# 1. Identifies the device (MAC, IP).
# 2. Registers with Nixstasis API.
# 3. Saves the returned UUID to disk.
################################################################################

SOURCE_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")" # Script's directory
source "${SOURCE_DIR}/_api.sh"

if ! MAC_ADDRESS="$(get_mac_address)"; then
  log_fatal "Unable to located mac_address, unable to register device with Nixstasis"
  exit 1
elif ! IP_ADDRESS="$(ip -4 -o addr show eth0 | awk '{print $4}' | cut -d/ -f1)"; then
  log_fatal "Unable to located WAN ip_address, unable to register device with Nixstasis"
  exit 2
fi

payload="$(DeviceCreate "${MAC_ADDRESS}" "${IP_ADDRESS}")"

if declare -A response="( $(register_device "${payload}" | json2aa) )"; then
  if grep -qP '^\w{8}(-\w{4}){3}-\w{12}$' <<< "${response[id]}"; then
    log_info "Received Nixstasis id: '${response[id]}'"
    set_id "${response[id]}"
  else
    log_fatal "id: '${response[id]}' was not a valid UUID"
    exit 3
  fi
else
  log_fatal "Unable to connect to Nixstasis: $?"
  exit 4
fi
