<%= if @device_offline do %>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <img src="/images/sad_little_toaster.png" alt="Sad Little Toaster" class="w-64 mb-8" />
    <h1 class="text-3xl font-bold mb-4">Device Offline</h1>
    <p class="text-xl text-gray-600 mb-8">
      It looks like your device is not feeling well, it appears to be offline.
    </p>
    <.link navigate={~p"/devices"} class="btn btn-primary">
      Back to Device List
    </.link>
  </div>
<% else %>
  <.header>
    Device {@device.mac_address}
    <:subtitle>
      <span class="font-bold">Account:</span> {@device.account_number} |
      <span class="font-bold">Product Name:</span> {@device.product_name} |
      <span class="font-bold">Last Seen:</span> {@device.last_seen_at || "Never"}
    </:subtitle>
    <:actions>
      <div class="flex items-center gap-2">
        <div
          class="tooltip tooltip-bottom"
          data-tip="If PCP or Terminal data becomes unavailable, restart the session without leaving this view."
        >
          <button class="btn btn-sm btn-outline" phx-click="retry_session">Restart Session</button>
        </div>
        <.link navigate={@return_to || ~p"/devices"} class="btn btn-ghost">Back to List</.link>
      </div>
    </:actions>
  </.header>

  <div class="mt-4">
    <div class={["grid grid-cols-1 md:grid-cols-3 gap-4", @terminal_maximized? && @active_tab == "terminal" && "hidden"]}>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title justify-center">CPU</h2>
          <div
            id="cpu-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@cpu_chart)}
            class="flex justify-center"
          >
          </div>
        </div>
      </div>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title justify-center">Memory</h2>
          <div
            id="memory-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@memory_chart)}
            class="flex justify-center"
          >
          </div>
        </div>
      </div>
      <div class="card bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title justify-center">Disk</h2>
          <div
            id="disk-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@disk_chart)}
            class="flex justify-center"
          >
          </div>
        </div>
      </div>
    </div>

    <div class={if(@terminal_maximized? and @active_tab == "terminal", do: "mt-4", else: "mt-8")}>
      <div role="tablist" class="tabs tabs-lifted">
        <a
          role="tab"
          class={"tab #{@active_tab == "overview" && "tab-active"}"}
          phx-click="change_tab"
          phx-value-tab="overview"
        >
          Overview
        </a>
        <a
          role="tab"
          class={"tab #{@active_tab == "pcp" && "tab-active"}"}
          phx-click="change_tab"
          phx-value-tab="pcp"
        >
          PCP Data
        </a>
        <a
          role="tab"
          class={"tab #{@active_tab == "terminal" && "tab-active"}"}
          phx-click="change_tab"
          phx-value-tab="terminal"
        >
          Terminal
        </a>
      </div>

      <div class="p-4 border-base-300 bg-base-100 border-x border-b rounded-b-box">
        <section class={if(@active_tab == "overview", do: "block", else: "hidden")}>
          <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
              <h3 class="font-bold">Device Session</h3>
              <p class="mt-1 text-sm text-base-content/70">
                Remote access is {if(@device.remote_access_requested, do: "requested", else: "not requested")}; approval is {@device.approval_status}.
              </p>
            </div>
            <a href={@cockpit_url} target="_blank" class="btn btn-primary">
              Open Cockpit
            </a>
          </div>
        </section>

        <section class={if(@active_tab == "pcp", do: "block", else: "hidden")}>
          <div class="mb-4 flex items-start justify-between gap-4">
            <div>
              <h3 class="font-bold">Performance History</h3>
              <p class="text-sm text-base-content/70">
                Latest heartbeat samples from PCP telemetry. Memory and disk are percentages; load is the 1 minute system load.
              </p>
            </div>
          </div>
          <div
            id="pcp-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@pcp_chart)}
            data-active={if(@active_tab == "pcp", do: "true", else: "false")}
            class="min-h-[560px]"
          >
          </div>
        </section>

        <section class={if(@active_tab == "terminal", do: "block min-h-0", else: "hidden")}>
          <div class="mb-3 flex items-center justify-between gap-4">
            <div>
              <h3 class="font-bold">Remote Terminal</h3>
              <p class="text-sm text-base-content/70">
                SSH session to the device support account through FRP.
              </p>
            </div>
            <button class="btn btn-sm btn-outline" phx-click="toggle_terminal_maximized">
              {if(@terminal_maximized?, do: "Restore", else: "Maximize")}
            </button>
          </div>
          <%= if @ssh_session_started or @terminal_closed? do %>
            <div class={[
              "bg-black text-white p-4 overflow-hidden rounded-lg min-h-0",
              if(@terminal_maximized?, do: "h-[calc(100vh-18rem)]", else: "h-[560px]")
            ]}>
              <div
                id="terminal-container"
                phx-update="ignore"
                phx-hook="TerminalHook"
                data-device-id={@device.id}
                data-token={@ssh_token}
                data-socket-token={@terminal_socket_token}
                data-command-id={@ssh_authorize_command_id}
                data-active={if(@active_tab == "terminal", do: "true", else: "false")}
                data-closed={if(@terminal_closed?, do: "true", else: "false")}
                class="h-full min-h-0 overflow-hidden font-mono relative"
              >
                <div class="text-gray-500">
                  <%= if @terminal_closed? do %>
                    Terminal session ended. Start a new session to reconnect.
                  <% else %>
                    Connecting to SSH session...
                  <% end %>
                </div>
              </div>
            </div>
            <div :if={@terminal_closed?} class="mt-4 flex items-center justify-between gap-4">
              <p class="text-sm text-base-content/70">
                Terminal session ended. Start a new session to reconnect.
              </p>
              <button class="btn btn-primary" phx-click="start_ssh_session">
                Start New Remote Session
              </button>
            </div>
          <% else %>
            <div class={[
              "flex flex-col items-center justify-center bg-base-200 rounded-lg",
              if(@terminal_maximized?, do: "h-[calc(100vh-18rem)]", else: "h-[560px]")
            ]}>
              <p class="text-lg">Opening remote session...</p>
              <p class="mt-2 text-sm text-base-content/60">
                Waiting for device authorization...
              </p>
            </div>
          <% end %>
        </section>
      </div>
    </div>
  </div>
<% end %>
