<%= if @device_offline do %>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center">
    <img src="/images/sad_little_toaster.png" alt="Sad Little Toaster" class="w-64 mb-8" />
    <h1 class="text-3xl font-bold mb-4">Device Offline</h1>
    <p class="text-xl text-base-content/70 mb-8">
      It looks like your device is not feeling well, it appears to be offline.
    </p>
    <.link navigate={~p"/devices"} class="btn btn-primary">
      Back to Device List
    </.link>
  </div>
<% else %>
  <.header>
    Device {@device.mac_address}
    <:subtitle>
      <span class="font-bold">Account:</span> {@device.account_number} |
      <span class="font-bold">Product Name:</span> {@device.product_name} |
      <span class="font-bold">Last Seen:</span> {@device.last_seen_at || "Never"}
    </:subtitle>
    <:actions>
      <.link navigate={@return_to || ~p"/devices"} class="btn btn-ghost">Back to List</.link>
    </:actions>
  </.header>

  <div class="mt-4">
    <div class={["grid grid-cols-1 md:grid-cols-3 gap-4", @maximized? && "hidden"]}>
      <div class="ui-card-panel">
        <div class="card-body">
          <h2 class="card-title justify-center">CPU</h2>
          <div
            id="cpu-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@cpu_chart)}
            class="flex justify-center"
          >
          </div>
        </div>
      </div>
      <div class="ui-card-panel">
        <div class="card-body">
          <h2 class="card-title justify-center">Memory</h2>
          <div
            id="memory-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@memory_chart)}
            class="flex justify-center"
          >
          </div>
        </div>
      </div>
      <div class="ui-card-panel">
        <div class="card-body">
          <h2 class="card-title justify-center">Disk</h2>
          <div
            id="disk-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@disk_chart)}
            class="flex justify-center"
          >
          </div>
        </div>
      </div>
    </div>

    <div id="tab-view" class={if(@maximized?, do: "mt-4", else: "mt-8")}>
      <div class="flex items-center justify-between gap-2 mb-3">
        <div role="tablist" class="tabs tabs-lifted">
          <a
            role="tab"
            class={"tab #{@active_tab == "pcp" && "tab-active"}"}
            phx-click="change_tab"
            phx-value-tab="pcp"
          >
            Performance History
          </a>
          <a
            role="tab"
            class={"tab #{@active_tab == "terminal" && "tab-active"}"}
            phx-click="change_tab"
            phx-value-tab="terminal"
          >
            Remote Terminal
          </a>
          <a
            role="tab"
            class={"tab #{@active_tab == "overview" && "tab-active"}"}
            phx-click="change_tab"
            phx-value-tab="overview"
          >
            Cockpit
          </a>
        </div>
        <div class="flex items-center gap-2">
          <div
            class="tooltip tooltip-bottom"
            data-tip="Restart session (reinitializes PCP, terminal, and remote access)"
          >
            <button
              class="btn btn-sm btn-outline"
              phx-click="retry_session"
              aria-label="Restart session"
            >
              <.icon name="fa-arrows-rotate" class="size-4" />
            </button>
          </div>
          <div
            id="tab-maximize-button"
            class="tooltip tooltip-bottom"
            data-tip={if @maximized?, do: "Minimize", else: "Maximize"}
          >
            <button
              class="btn btn-sm btn-outline"
              phx-click="toggle_maximized"
              aria-label={if @maximized?, do: "Minimize", else: "Maximize"}
            >
              <.icon
                name={
                  if @maximized?,
                    do: "fa-down-left-and-up-right-to-center",
                    else: "fa-up-right-and-down-left-from-center"
                }
                class="size-4"
              />
            </button>
          </div>
          <div class="tooltip tooltip-bottom" data-tip="Fullscreen">
            <button
              id="tab-fullscreen-button"
              phx-hook="Fullscreen"
              data-fullscreen-target="tab-view"
              class="btn btn-sm btn-outline"
              aria-label="Toggle fullscreen"
            >
              <.icon name="fa-maximize" class="size-4" />
            </button>
          </div>
        </div>
      </div>

      <div
        id="tab-content-panel"
        class={[
          "p-4 border-base-300 bg-base-100 border-x border-b rounded-b-box",
          if(@maximized?, do: "h-[calc(100vh-10rem)] flex flex-col", else: "")
        ]}
      >
        <section class={if(@active_tab == "overview", do: "block flex-1 min-h-0", else: "hidden")}>
          <iframe
            id="cockpit-frame"
            src={@cockpit_url}
            title="Cockpit"
            allow="fullscreen"
            class={
              if(@maximized?, do: "h-full w-full border-0 rounded-box", else: "w-full h-[800px] border-0 rounded-box")
            }
          >
          </iframe>
        </section>

        <section class={if(@active_tab == "pcp", do: "block flex-1 min-h-0", else: "hidden")}>
          <div
            id="pcp-chart"
            phx-hook="ApexChart"
            phx-update="ignore"
            data-options={Jason.encode!(@pcp_chart)}
            data-active={if(@active_tab == "pcp", do: "true", else: "false")}
            class={if(@maximized?, do: "h-full", else: "min-h-[600px]")}
          >
          </div>
        </section>

        <section class={if(@active_tab == "terminal", do: "block flex-1 min-h-0 flex flex-col", else: "hidden")}>
          <%= if @ssh_session_started or @terminal_closed? do %>
            <div
              id="tab-terminal-wrapper"
              class={[
                "bg-black text-white p-4 overflow-hidden rounded-lg min-h-0",
                if(@maximized?, do: "flex-1", else: "h-[560px]")
              ]}
            >
              <div
                id="terminal-container"
                phx-update="ignore"
                phx-hook="TerminalHook"
                data-device-id={@device.id}
                data-token={@ssh_token}
                data-socket-token={@terminal_socket_token}
                data-command-id={@ssh_authorize_command_id}
                data-active={if(@active_tab == "terminal", do: "true", else: "false")}
                data-closed={if(@terminal_closed?, do: "true", else: "false")}
                class="h-full min-h-0 overflow-hidden font-mono relative"
              >
                <div class="text-base-content/70">
                  <%= if @terminal_closed? do %>
                    Terminal session ended. Start a new session to reconnect.
                  <% else %>
                    Connecting to SSH session...
                  <% end %>
                </div>
              </div>
            </div>
            <div :if={@terminal_closed?} class="mt-4">
              <p class="text-sm text-base-content/70">
                Terminal session ended. Start a new session to reconnect.
              </p>
            </div>
          <% else %>
            <div
              id="tab-terminal-wrapper"
              class={[
                "flex flex-col items-center justify-center bg-base-200 rounded-lg min-h-0",
                if(@maximized?, do: "flex-1", else: "h-[560px]")
              ]}
            >
              <p class="text-lg">Opening remote session...</p>
              <p class="mt-2 text-sm text-base-content/60">
                Waiting for device authorization...
              </p>
            </div>
          <% end %>
        </section>
      </div>
    </div>
  </div>
<% end %>
