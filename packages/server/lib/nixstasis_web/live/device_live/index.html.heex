<div class="p-4">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold">Devices</h1>
    <div class="flex gap-2">
      <.form for={%{}} as={:search} phx-submit="search" phx-change="search" class="flex gap-2">
        <input
          type="text"
          name="search"
          value={@search}
          placeholder="Search devices..."
          class="input input-bordered input-sm"
          phx-debounce="300"
        />
      </.form>
      <div class="join">
        <.link
          patch={~p"/devices?#{%{approval_status: "approved"}}"}
          class={"btn btn-sm join-item #{@filter_approval_status == "approved" && "btn-active"}"}
        >
          Approved
        </.link>
        <.link
          patch={~p"/devices?#{%{approval_status: "pending"}}"}
          class={"btn btn-sm join-item #{@filter_approval_status == "pending" && "btn-active"}"}
        >
          Pending
        </.link>
        <.link
          patch={~p"/devices?#{%{approval_status: "rejected"}}"}
          class={"btn btn-sm join-item #{@filter_approval_status == "rejected" && "btn-active"}"}
        >
          Rejected
        </.link>
        <.link
          patch={~p"/devices?#{%{connectivity_status: "online"}}"}
          class={"btn btn-sm join-item #{@filter_connectivity_status == "online" && "btn-active"}"}
        >
          Online
        </.link>
        <.link
          patch={~p"/devices?#{%{connectivity_status: "offline"}}"}
          class={"btn btn-sm join-item #{@filter_connectivity_status == "offline" && "btn-active"}"}
        >
          Offline
        </.link>
        <.link
          patch={~p"/devices"}
          class={"btn btn-sm join-item #{is_nil(@filter_approval_status) && is_nil(@filter_connectivity_status) && "btn-active"}"}
        >
          All
        </.link>
      </div>
      <.link patch={~p"/devices/new"} class="btn btn-sm btn-primary">
        Add Device
      </.link>
    </div>
  </div>

  <%= if length(@selected_ids) > 0 do %>
    <div class="bg-base-200 p-2 rounded-lg mb-4 flex gap-4 items-center">
      <span class="font-semibold">{length(@selected_ids)} selected</span>
      <button phx-click="bulk_approve" class="btn btn-sm btn-success">Approve</button>
      <button phx-click="bulk_reject" class="btn btn-sm btn-error">Reject</button>
    </div>
  <% end %>

  <%= if map_size(@active_filters) > 0 do %>
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class="text-sm font-semibold">Active filters:</span>
      <%= for {key, value} <- @active_filters do %>
        <button
          class="badge badge-outline gap-2 px-3 py-3"
          phx-click="remove_filter"
          phx-value-key={key}
        >
          <span>{Phoenix.Naming.humanize(key)}: {value}</span>
          <span aria-hidden="true">×</span>
        </button>
      <% end %>
      <button class="btn btn-xs btn-ghost" phx-click="clear_filters">Clear all</button>
    </div>
  <% end %>

  <div class="overflow-x-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>
            <input
              type="checkbox"
              id="select-all-checkbox"
              class="checkbox checkbox-sm"
              phx-click="toggle_all"
              phx-hook="IndeterminateCheckbox"
              data-selected-count={length(@selected_ids)}
              data-total-count={@total_count}
            />
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="mac_address"
            class="cursor-pointer hover:text-primary"
          >
            MAC Address {if @sort_by == :mac_address,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="product_name"
            class="cursor-pointer hover:text-primary"
          >
            Product {if @sort_by == :product_name,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="account_number"
            class="cursor-pointer hover:text-primary"
          >
            Account # {if @sort_by == :account_number,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="approval_status"
            class="cursor-pointer hover:text-primary"
          >
            Status {if @sort_by == :approval_status,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th>Online</th>
        </tr>
      </thead>
      <tbody id="devices-stream" phx-update="stream">
        <tr
          :for={{dom_id, device} <- @streams.devices}
          id={dom_id}
          class="hover"
        >
          <td>
            <input
              type="checkbox"
              class="checkbox checkbox-sm"
              phx-click="toggle_selection"
              phx-value-id={device.id}
              checked={device.id in @selected_ids}
            />
          </td>
          <td class="font-mono">
            <button
              class="link link-hover"
              phx-click="open_device_details"
              phx-value-id={device.id}
            >
              {device.mac_address}
            </button>
          </td>
          <td>
            <%= if is_nil(device.product_name) or device.product_name == "" do %>
              <span class="text-base-content/60">N/A</span>
            <% else %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "product", to_string(device.product_name))}"}
                class="link link-hover text-left"
              >
                {device.product_name}
              </.link>
            <% end %>
          </td>
          <td class="font-mono">
            <%= if is_nil(device.account_number) or device.account_number == "" do %>
              <span class="text-base-content/60">N/A</span>
            <% else %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "account_number", to_string(device.account_number))}"}
                class="link link-hover text-left"
              >
                {device.account_number}
              </.link>
            <% end %>
          </td>
          <td>
            <.link
              patch={~p"/devices?#{Map.put(@current_params, "approval_status", to_string(device.approval_status))}"}
              class={"badge w-24 #{case device.approval_status do
                :approved -> "badge-success text-success-content"
                :rejected -> "badge-error text-error-content"
                _ -> "bg-amber-200 text-amber-900 border-amber-300 dark:bg-amber-500/30 dark:text-amber-200 dark:border-amber-400/40"
              end}"}
            >
              {device.approval_status}
            </.link>
          </td>
          <td>
            <%= if Nixstasis.Devices.online?(device) do %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "connectivity_status", "online")}"}
                class="badge badge-success w-24"
              >
                online
              </.link>
            <% else %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "connectivity_status", "offline")}"}
                class="badge badge-error w-24"
              >
                offline
              </.link>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<.modal :if={@live_action in [:new]} id="device-modal" show on_cancel={JS.patch(~p"/devices")}>
  <.live_component
    module={NixstasisWeb.DeviceLive.FormComponent}
    id={@device.id || :new}
    title={@page_title}
    action={@live_action}
    device={@device}
    patch={~p"/devices"}
  />
</.modal>
