<div class="p-4">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">Devices</h1>
    <div class="flex flex-1 flex-wrap justify-end gap-2">
      <.form
        for={%{}}
        as={:search}
        phx-submit="search"
        phx-change="search"
        class="flex w-full gap-2 sm:w-auto"
      >
        <input
          type="text"
          name="search"
          value={@search}
          placeholder="Search devices..."
          class="ui-input w-full sm:w-auto"
          phx-debounce="300"
        />
      </.form>
      <div :if={@can_view_device_details?} class="flex flex-wrap gap-1">
        <.link
          patch={~p"/devices?#{Map.put(@current_params, "approval_status", "approved")}"}
          class={"btn btn-sm #{@filter_approval_status == "approved" && "btn-active"}"}
        >
          Approved
        </.link>
        <.link
          patch={~p"/devices?#{Map.put(@current_params, "approval_status", "pending")}"}
          class={"btn btn-sm #{@filter_approval_status == "pending" && "btn-active"}"}
        >
          Pending
        </.link>
        <.link
          patch={~p"/devices?#{Map.put(@current_params, "approval_status", "rejected")}"}
          class={"btn btn-sm #{@filter_approval_status == "rejected" && "btn-active"}"}
        >
          Rejected
        </.link>
        <.link
          patch={~p"/devices?#{Map.put(@current_params, "connectivity_status", "online")}"}
          class={"btn btn-sm #{@filter_connectivity_status == "online" && "btn-active"}"}
        >
          Online
        </.link>
        <.link
          patch={~p"/devices?#{Map.put(@current_params, "connectivity_status", "offline")}"}
          class={"btn btn-sm #{@filter_connectivity_status == "offline" && "btn-active"}"}
        >
          Offline
        </.link>
        <.link
          patch={~p"/devices?#{Map.drop(@current_params, ["approval_status", "connectivity_status"])}"}
          class={"btn btn-sm #{is_nil(@filter_approval_status) && is_nil(@filter_connectivity_status) && "btn-active"}"}
        >
          All
        </.link>
      </div>
      <button
        :if={@can_view_device_details?}
        id="manage-device-groups"
        type="button"
        class="btn btn-sm btn-outline"
        phx-click="toggle_group_panel"
        aria-expanded={to_string(@group_panel_open?)}
        aria-controls="device-group-panel"
      >
        Groups
      </button>
      <.link
        :if={NixstasisWeb.Permissions.can_create_devices?(@device_permissions)}
        patch={~p"/devices/new"}
        class="btn btn-sm btn-primary"
      >
        Add Device
      </.link>
    </div>
  </div>

  <section
    :if={@group_panel_open?}
    id="device-group-panel"
    class="mb-5 overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm"
    aria-labelledby="device-group-heading"
    phx-window-keydown="group_panel_keydown"
    phx-key="escape"
  >
    <div class="flex flex-wrap items-start justify-between gap-3 border-b border-base-300 bg-base-200/60 px-4 py-3">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary">Fleet map</p>
        <h2 id="device-group-heading" class="text-lg font-bold">Device groups</h2>
        <p class="text-sm text-base-content/65">Manual organization only; device behavior stays unchanged.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button
          :if={NixstasisWeb.Permissions.can_manage_all_devices?(@device_permissions)}
          id="toggle-archived-groups"
          type="button"
          class="btn btn-sm btn-ghost"
          phx-click="toggle_archived_groups"
        >
          {if @show_archived_groups?, do: "Hide archived", else: "Show archived"}
        </button>
        <button
          :if={NixstasisWeb.Permissions.can_manage_all_devices?(@device_permissions)}
          id="new-device-group"
          type="button"
          class="btn btn-sm btn-primary"
          phx-click="new_group"
        >
          New group
        </button>
        <button type="button" class="btn btn-sm btn-ghost" phx-click="close_group_panel" aria-label="Close groups">
          Close
        </button>
      </div>
    </div>

    <div class="grid gap-4 p-4 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.7fr)]">
      <div class="space-y-2" aria-live="polite" aria-busy={to_string(@groups_loading?)}>
        <div :if={@groups_loading?} class="flex items-center gap-2 py-6 text-sm text-base-content/65">
          <span class="loading loading-spinner loading-sm" aria-hidden="true"></span> Loading groups…
        </div>

        <div
          :if={!@groups_loading? and @device_groups == []}
          id="device-groups-empty"
          class="rounded-xl border border-dashed border-base-300 px-4 py-8 text-center"
        >
          <p class="font-semibold">
            {if NixstasisWeb.Permissions.can_manage_all_devices?(@device_permissions),
              do: "No active groups yet",
              else: "No groups are visible for your device scope"}
          </p>
          <p class="mt-1 text-sm text-base-content/60">
            {if NixstasisWeb.Permissions.can_manage_all_devices?(@device_permissions),
              do: "Create a group to begin organizing this fleet.",
              else: "Groups appear after an accessible device is assigned."}
          </p>
        </div>

        <article
          :for={row <- @device_groups}
          class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-base-300 border-l-4 border-l-primary bg-base-100 px-4 py-3"
          data-group-name={row.group.name}
          data-group-id={row.group.id}
        >
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-semibold">{row.group.name}</h3>
              <span :if={row.group.archived_at} class="badge badge-ghost badge-sm">Archived</span>
              <span class="badge badge-outline badge-sm">
                {row.visible_device_count} visible {if row.visible_device_count == 1, do: "device", else: "devices"}
              </span>
            </div>
            <p :if={row.group.description not in [nil, ""]} class="mt-1 text-sm text-base-content/65">
              {row.group.description}
            </p>
          </div>
          <div
            :if={NixstasisWeb.Permissions.can_manage_all_devices?(@device_permissions)}
            class="flex flex-wrap gap-1"
          >
            <button
              :if={is_nil(row.group.archived_at)}
              type="button"
              class="btn btn-xs btn-ghost"
              phx-click="edit_group"
              phx-value-id={row.group.id}
            >
              Edit
            </button>
            <button
              :if={is_nil(row.group.archived_at)}
              type="button"
              class="btn btn-xs btn-ghost"
              phx-click="archive_group"
              phx-value-id={row.group.id}
              phx-disable-with="Archiving…"
            >
              Archive
            </button>
            <button
              :if={row.group.archived_at}
              type="button"
              class="btn btn-xs btn-ghost"
              phx-click="restore_group"
              phx-value-id={row.group.id}
              phx-disable-with="Restoring…"
            >
              Restore
            </button>
            <button
              :if={row.group.archived_at}
              type="button"
              class="btn btn-xs btn-error btn-outline"
              phx-click="request_group_delete"
              phx-value-id={row.group.id}
            >
              Delete permanently
            </button>
          </div>
        </article>
      </div>

      <div class="space-y-3">
        <.form
          :if={@group_form}
          for={%{}}
          as={:group}
          id="device-group-form"
          phx-submit="save_group"
          class="rounded-xl border border-base-300 bg-base-200/45 p-4"
        >
          <h3 class="font-semibold">{if @group_form.id, do: "Edit group", else: "New group"}</h3>
          <label class="form-control mt-3 w-full">
            <span class="label-text mb-1">Name</span>
            <input
              type="text"
              name="group[name]"
              value={@group_form.name}
              class="input input-bordered w-full"
              required
              maxlength="120"
              autocomplete="off"
            />
          </label>
          <label class="form-control mt-3 w-full">
            <span class="label-text mb-1">Description</span>
            <textarea
              name="group[description]"
              class="textarea textarea-bordered min-h-24 w-full"
              maxlength="500"
            >{@group_form.description}</textarea>
          </label>
          <div class="mt-4 flex justify-end gap-2">
            <button type="button" class="btn btn-sm btn-ghost" phx-click="cancel_group_form">Cancel</button>
            <button type="submit" class="btn btn-sm btn-primary" phx-disable-with="Saving…">Save group</button>
          </div>
        </.form>

        <div
          :if={@pending_group_delete}
          id="confirm-group-delete"
          role="region"
          aria-labelledby="confirm-group-delete-heading"
          tabindex="0"
          class="rounded-xl border border-error/40 bg-error/10 p-4"
        >
          <h3 id="confirm-group-delete-heading" class="font-semibold">Permanently delete this group?</h3>
          <p class="mt-1 text-sm">
            {@pending_group_delete.name} can be deleted only when it has no device memberships. This cannot be undone.
          </p>
          <div class="mt-4 flex justify-end gap-2">
            <button type="button" class="btn btn-sm btn-ghost" phx-click="cancel_group_delete">Cancel</button>
            <button
              type="button"
              class="btn btn-sm btn-error"
              phx-click="confirm_group_delete"
              phx-disable-with="Deleting…"
            >
              Delete permanently
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%= if NixstasisWeb.Permissions.can_manage_devices?(@device_permissions) and length(@selected_ids) > 0 do %>
    <div class="mb-4 flex flex-wrap items-center gap-3 rounded-xl border border-base-300 bg-base-200 p-3">
      <span class="font-semibold">{length(@selected_ids)} selected</span>
      <div class="flex gap-2">
        <button phx-click="bulk_approve" class="btn btn-sm btn-success">Approve</button>
        <button phx-click="bulk_reject" class="btn btn-sm btn-error">Reject</button>
      </div>
      <.form
        :if={@device_groups != []}
        for={%{}}
        id="membership-group-form"
        phx-change="select_membership_group"
        class="ml-auto flex flex-wrap items-center gap-2"
      >
        <label for="membership-group-select" class="text-sm font-medium">Group</label>
        <select
          id="membership-group-select"
          name="group_id"
          class="select select-bordered select-sm min-w-44"
        >
          <option value="" selected={is_nil(@selected_group_id)}>Choose a group</option>
          <option
            :for={row <- @device_groups}
            :if={is_nil(row.group.archived_at)}
            value={row.group.id}
            selected={@selected_group_id == row.group.id}
          >
            {row.group.name}
          </option>
        </select>
        <button
          id="add-selected-to-group"
          type="button"
          class="btn btn-sm btn-primary"
          phx-click="add_selected_to_group"
          phx-disable-with="Adding…"
        >
          Add to group
        </button>
        <button
          id="remove-selected-from-group"
          type="button"
          class="btn btn-sm btn-outline"
          phx-click="remove_selected_from_group"
          phx-disable-with="Removing…"
        >
          Remove from group
        </button>
      </.form>
      <p :if={@device_groups == []} class="ml-auto text-sm text-base-content/60">
        No visible groups are available for membership changes.
      </p>
    </div>
  <% end %>

  <%= if map_size(@active_filters) > 0 do %>
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <span class="text-sm font-semibold">Active filters:</span>
      <%= for {key, value} <- @active_filters do %>
        <button
          class="badge badge-outline gap-2 px-3 py-3"
          phx-click="remove_filter"
          phx-value-key={key}
          data-group-filter-name={key == "group_id" && value}
        >
          <span>{Phoenix.Naming.humanize(key)}: {value}</span>
          <span aria-hidden="true">×</span>
        </button>
      <% end %>
      <button class="btn btn-xs btn-ghost" phx-click="clear_filters">Clear all</button>
    </div>
  <% end %>

  <div class="overflow-x-auto">
    <div :if={!@can_view_device_details?} class="alert alert-warning">
      You are not authorized to view devices.
    </div>
    <div :if={@group_filter_unavailable?} class="alert alert-info mb-4" role="status">
      <span>The requested group is unavailable.</span>
      <.link patch={~p"/devices?#{@current_params}"} class="btn btn-sm btn-outline">
        Continue without group filter
      </.link>
    </div>
    <table :if={@can_view_device_details?} class="table table-zebra">
      <thead>
        <tr>
          <th :if={NixstasisWeb.Permissions.can_manage_devices?(@device_permissions)}>
            <input
              type="checkbox"
              id="select-all-checkbox"
              class="checkbox checkbox-sm"
              phx-click="toggle_all"
              phx-hook="IndeterminateCheckbox"
              data-selected-count={length(@selected_ids)}
              data-total-count={@total_count}
            />
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="mac_address"
            class="ui-sortable-header"
          >
            MAC Address {if @sort_by == :mac_address,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="product_name"
            class="ui-sortable-header"
          >
            Product {if @sort_by == :product_name,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="account_number"
            class="ui-sortable-header"
          >
            Account # {if @sort_by == :account_number,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="ipv4_address"
            class="ui-sortable-header"
          >
            IPv4 {if @sort_by == :ipv4_address,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th
            phx-click="sort"
            phx-value-sort_by="approval_status"
            class="ui-sortable-header"
          >
            Status {if @sort_by == :approval_status,
              do: if(@sort_order == :asc, do: "▲", else: "▼")}
          </th>
          <th>Online</th>
          <th data-group-summary-heading class="hidden lg:table-cell">Groups</th>
        </tr>
      </thead>
      <tbody id="devices-stream" phx-update="stream">
        <tr
          :for={{dom_id, device} <- @streams.devices}
          id={dom_id}
          class="hover"
        >
          <td :if={NixstasisWeb.Permissions.can_manage_devices?(@device_permissions)}>
            <input
              type="checkbox"
              class="checkbox checkbox-sm"
              phx-click="toggle_selection"
              phx-value-id={device.id}
              checked={device.id in @selected_ids}
            />
          </td>
          <td class="font-mono">
            <button
              class="link link-hover"
              phx-click="open_device_details"
              phx-value-id={device.id}
            >
              {device.mac_address}
            </button>
          </td>
          <td>
            <%= if is_nil(device.product_name) or device.product_name == "" do %>
              <span class="text-base-content/60">N/A</span>
            <% else %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "product", to_string(device.product_name))}"}
                class="link link-hover text-left"
              >
                {device.product_name}
              </.link>
            <% end %>
          </td>
          <td class="font-mono">
            <%= if is_nil(device.account_number) or device.account_number == "" do %>
              <span class="text-base-content/60">N/A</span>
            <% else %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "account_number", to_string(device.account_number))}"}
                class="link link-hover text-left"
              >
                {device.account_number}
              </.link>
            <% end %>
          </td>
          <td class="font-mono">
            <%= if is_nil(device.ipv4_address) or device.ipv4_address == "" do %>
              <span class="text-base-content/60">N/A</span>
            <% else %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "ipv4_address", to_string(device.ipv4_address))}"}
                class="link link-hover text-left"
              >
                {device.ipv4_address}
              </.link>
            <% end %>
          </td>
          <td>
            <.link
              patch={~p"/devices?#{Map.put(@current_params, "approval_status", to_string(device.approval_status))}"}
              class={"badge w-24 #{case device.approval_status do
                :approved -> "badge-success text-success-content"
                :rejected -> "badge-error text-error-content"
                _ -> "badge-warning text-warning-content"
              end}"}
            >
              {device.approval_status}
            </.link>
          </td>
          <td>
            <%= if Nixstasis.Devices.online?(device) do %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "connectivity_status", "online")}"}
                class="badge badge-success w-24"
              >
                online
              </.link>
            <% else %>
              <.link
                patch={~p"/devices?#{Map.put(@current_params, "connectivity_status", "offline")}"}
                class="badge badge-error w-24"
              >
                offline
              </.link>
            <% end %>
          </td>
          <td class="hidden lg:table-cell" data-device-group-summary={device.id}>
            <% groups = active_device_groups(device) %>
            <span :if={groups == []} class="text-sm text-base-content/50">—</span>
            <div :if={groups != []} class="flex max-w-64 flex-wrap gap-1">
              <.link
                :for={group <- Enum.take(groups, 2)}
                patch={~p"/devices?#{Map.put(@current_params, "group_id", group.id)}"}
                class="badge badge-outline badge-sm max-w-32 truncate"
                title={group.name}
              >
                {group.name}
              </.link>
              <span :if={length(groups) > 2} class="badge badge-ghost badge-sm">
                +{length(groups) - 2}
              </span>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<.modal :if={@live_action in [:new]} id="device-modal" show on_cancel={JS.patch(~p"/devices")}>
  <.live_component
    module={NixstasisWeb.DeviceLive.FormComponent}
    id={@device.id || :new}
    title={@page_title}
    action={@live_action}
    device={@device}
    device_permissions={@device_permissions}
    patch={~p"/devices"}
  />
</.modal>
