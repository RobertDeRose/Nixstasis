<div class="ui-page-shell space-y-4">
  <.header>
    Command Policies
    <:subtitle>Manage allowed command names and absolute paths for device policy delivery.</:subtitle>
    <:actions>
      <.link navigate={~p"/scripts"} class="btn btn-sm btn-ghost">Back to Scripts</.link>
      <.link
        :if={@can_manage}
        patch={~p"/scripts/command-policies/new?#{@current_params}"}
        class="btn btn-sm btn-primary"
      >
        New Command Entry
      </.link>
    </:actions>
  </.header>

  <div class="flex flex-wrap items-center gap-3 rounded-box border border-base-300 bg-base-100 p-4">
    <input
      type="text"
      name="search"
      value={@current_params["search"]}
      placeholder="Search name, path, description"
      aria-label="Search command entries"
      class="input input-bordered min-w-56 flex-1"
      phx-change="filter"
    />

    <select
      name="category_id"
      class="select select-bordered w-auto max-w-full"
      aria-label="Category"
      phx-change="filter"
    >
      <option value="">All categories</option>
      <option
        :for={category <- @categories}
        value={category.id}
        selected={@current_params["category_id"] == category.id}
      >
        {category.display_name}
      </option>
    </select>

    <select name="status" class="select select-bordered w-auto max-w-full" aria-label="Status" phx-change="filter">
      <option value="">All statuses</option>
      <option value="enabled" selected={@current_params["status"] == "enabled"}>Enabled</option>
      <option value="archived" selected={@current_params["status"] == "archived"}>Disabled</option>
    </select>

    <select
      name="assigned"
      class="select select-bordered w-auto max-w-full"
      aria-label="Assignment state"
      phx-change="filter"
    >
      <option value="">All assignment states</option>
      <option value="assigned" selected={@current_params["assigned"] == "assigned"}>Assigned</option>
      <option value="unassigned" selected={@current_params["assigned"] == "unassigned"}>Unassigned</option>
    </select>

    <button type="button" class="btn btn-ghost" phx-click="clear_filters">Clear</button>
  </div>

  <%= if @selected_assignment_entry_id do %>
    <div class="alert alert-info">
      <.icon name="hero-arrow-right-circle" class="size-5" />
      <span>
        Entry preselected for the upcoming assignment wizard:
        <span class="font-semibold">{@selected_assignment_entry_id}</span>
      </span>
    </div>
  <% end %>

  <section class="rounded-box border border-base-300 bg-base-100 p-4">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Categories</h2>
      <%= if @can_manage do %>
        <.link patch={~p"/scripts/command-policies/categories/new?#{@current_params}"} class="btn btn-sm btn-primary">
          New Category
        </.link>
      <% end %>
    </div>
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      <div :for={category <- @categories} class="rounded-box border border-base-300 p-3">
        <div class="flex items-start justify-between gap-2">
          <div>
            <div class="font-medium">{category.display_name}</div>
            <div class="text-xs text-base-content/70">{category.slug}</div>
          </div>
          <button
            type="button"
            class="btn btn-xs btn-ghost"
            phx-click="assign_category_shortcut"
            phx-value-id={category.id}
          >
            Assign
          </button>
        </div>
        <p class="mt-2 text-sm text-base-content/70">{category.description}</p>
        <div class="mt-3 flex flex-wrap gap-2 text-xs text-base-content/70">
          <span>{category_entry_count(category.id)} entries</span>
          <span>{category_assignment_count(category.id)} active assignments</span>
        </div>
        <%= if @can_manage do %>
          <div class="mt-3 flex gap-2">
            <.link
              patch={~p"/scripts/command-policies/categories/#{category.id}/edit?#{@current_params}"}
              class="btn btn-xs btn-ghost"
            >
              Edit
            </.link>
            <button
              type="button"
              class="btn btn-xs btn-ghost text-error"
              phx-click="request_delete_category"
              phx-value-id={category.id}
            >
              Delete
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="rounded-box border border-base-300 bg-base-100 p-4">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Device Assignments</h2>
      <button type="button" class="btn btn-sm btn-ghost" phx-click="refresh">Refresh</button>
    </div>

    <.form
      for={%{}}
      as={:assignment}
      id="assignment-form"
      phx-change="change_assignment"
      phx-submit="preview_assignment"
      class="space-y-3"
    >
      <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        <.assignment_picker
          name="device_ids"
          legend="Devices"
          selected={@assignment_form["device_ids"]}
          options={for device <- @devices, do: {device.id, device_label(device)}}
        />
        <.assignment_picker
          name="entry_ids"
          legend="Command entries"
          selected={@assignment_form["entry_ids"]}
          options={for row <- @entries, do: {row.entry.id, row.entry.name}}
        />
        <.assignment_picker
          name="category_ids"
          legend="Categories"
          selected={@assignment_form["category_ids"]}
          options={for category <- @categories, do: {category.id, category.display_name}}
        />
        <.assignment_picker
          name="catalog_command_ids"
          legend="Catalog commands"
          selected={@assignment_form["catalog_command_ids"]}
          options={for command <- @catalog_commands, do: {command.id, command.name}}
        />
        <.assignment_picker
          name="catalog_category_ids"
          legend="Catalog categories"
          selected={@assignment_form["catalog_category_ids"]}
          options={for category <- @catalog_categories, do: {category.id, category.display_name}}
        />
      </div>
      <div class="flex justify-end">
        <button type="submit" class="btn btn-primary">Preview</button>
      </div>
    </.form>

    <%= if @assignment_preview do %>
      <div id="assignment-preview" class="mt-4 space-y-4 rounded-box border border-base-300 p-4">
        <div>
          <h3 class="font-semibold">Preview</h3>
          <p class="text-sm text-base-content/70">
            {length(@assignment_preview.device_ids)} {if length(@assignment_preview.device_ids) == 1,
              do: "device",
              else: "devices"} · {map_size(@assignment_preview.commands)} manual {if map_size(
                                                                                       @assignment_preview.commands
                                                                                     ) == 1,
                                                                                     do: "command",
                                                                                     else: "commands"}
          </p>
        </div>

        <div :if={@assignment_preview.commands != %{}}>
          <h4 class="text-sm font-semibold">Commands for every selected device</h4>
          <.table
            id="manual-preview"
            rows={Enum.sort(@assignment_preview.commands)}
            class="table-sm"
          >
            <:col :let={{name, _path}} label="Command" class="font-medium">{name}</:col>
            <:col :let={{_name, path}} label="Path"><code class="text-xs">{path}</code></:col>
          </.table>
        </div>

        <div :if={@assignment_preview.conflicts != []} role="alert" class="alert alert-error">
          <div>
            <p class="font-semibold">Commands with conflicting paths are left out:</p>
            <ul class="mt-1 list-disc pl-5 text-sm">
              <li :for={conflict <- @assignment_preview.conflicts}>
                {conflict.name}: {Enum.join(conflict.paths, ", ")}
              </li>
            </ul>
          </div>
        </div>

        <div :if={catalog_preview_rows(@assignment_preview.catalog) != []}>
          <h4 class="text-sm font-semibold">Catalog commands on each device</h4>
          <.table id="catalog-preview" rows={catalog_preview_rows(@assignment_preview.catalog)} class="table-sm">
            <:col :let={row} label="Device">{device_name(@devices, row.device_id)}</:col>
            <:col :let={row} label="Command">{row.name}</:col>
            <:col :let={row} label="Status">
              <span class={["badge badge-sm", catalog_status_badge(row.result.status)]}>{catalog_status_text(
                row.result.status
              )}</span>
            </:col>
            <:col :let={row} label="Path">
              <code class="text-xs">{Map.get(row.result, :command_path, "—")}</code>
            </:col>
            <:col :let={row} label="Details" class="max-w-md text-xs">
              <div :if={Map.get(row.result, :package_name)}>Package: {row.result.package_name}</div>
              <div :if={Map.get(row.result, :install_hint)}>Install: {row.result.install_hint}</div>
              <div :if={Map.get(row.result, :observed_path)}>Observed path: {row.result.observed_path}</div>
              <div :if={Map.get(row.result, :manual_path)}>Manual path: {row.result.manual_path}</div>
            </:col>
          </.table>
        </div>

        <%= if @assignment_preview.conflicts == [] and @assignment_preview.catalog_blockers == [] do %>
          <button class="btn btn-sm btn-primary" phx-click="confirm_assignment">Confirm and queue</button>
        <% else %>
          <div class="alert alert-error">
            Conflicts or incompatible catalog commands detected; remove blocked sources before confirming.
          </div>
        <% end %>

        <details>
          <summary class="cursor-pointer text-sm text-base-content/70">Raw policy payload</summary>
          <pre class="mt-2 max-h-48 overflow-auto rounded bg-base-200 p-3 text-xs">{Jason.encode!(%{manual: @assignment_preview.payload, catalog: @assignment_preview.catalog_commands, catalog_blockers: @assignment_preview.catalog_blockers}, pretty: true)}</pre>
        </details>
      </div>
    <% end %>

    <p :if={@assignments == []} class="mt-4 text-sm text-base-content/70">
      No device has a command policy yet. Pick devices and commands above, then Preview.
    </p>
    <div :if={@assignments != []} class="mt-4">
      <.table id="policy-assignments" rows={@assignments} class="table-sm">
        <:col :let={assignment} label="Device">{assignment.device_id}</:col>
        <:col :let={assignment} label="Revision">{assignment.revision}</:col>
        <:col :let={assignment} label="Status">
          <span class="badge badge-outline">{assignment.status}</span>
          <span :if={assignment.drift_warning} class="badge badge-warning">drift</span>
        </:col>
        <:col :let={assignment} label="Last result">
          {case latest_result(@delivery_results, assignment.id) do
            nil -> "pending/offline"
            result -> "#{result.status}: #{result.failure_reason || "ok"}"
          end}
        </:col>
        <:action :let={assignment}>
          <div class="flex items-start gap-2">
            <div class="join" role="group" aria-label={"Actions for #{assignment.device_id}"}>
              <.bar_button
                icon="hero-arrow-path-mini"
                label="Retry/resend"
                target={assignment.device_id}
                phx-click="retry_assignment"
                phx-value-id={assignment.id}
              />
              <.bar_button
                icon="hero-flag-mini"
                label="Toggle drift"
                target={assignment.device_id}
                phx-click="toggle_drift_warning"
                phx-value-id={assignment.id}
              />
              <.bar_button
                icon="hero-no-symbol-mini"
                label="Revoke all"
                target={assignment.device_id}
                danger
                phx-click="revoke_all"
                phx-value-device-id={assignment.device_id}
                data-confirm="Queue deny-all policy for this device?"
              />
            </div>
            <details>
              <summary
                class={bar_button_class(false)}
                data-tip="Raw policy"
                aria-label={"Raw policy #{assignment.device_id}"}
              >
                <.icon name="hero-code-bracket-mini" class="size-4" />
              </summary>
              <pre class="mt-2 max-w-md overflow-auto rounded bg-base-200 p-2 text-xs font-normal">{Jason.encode!(assignment.resolved_policy, pretty: true)}</pre>
            </details>
          </div>
        </:action>
      </.table>
    </div>
  </section>

  <%= if @entries == [] do %>
    <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-10 text-center text-base-content/70">
      No command entries found.
    </div>
  <% else %>
    <div class="overflow-hidden rounded-box border border-base-300 bg-base-100">
      <.table id="command-entries" rows={@entries}>
        <:col :let={row} label="Name" class="font-medium">{row.entry.name}</:col>
        <:col :let={row} label="Path"><code class="text-xs">{row.entry.command_path}</code></:col>
        <:col :let={row} label="Status">
          <span class={"badge #{if is_nil(row.entry.archived_at), do: "badge-success", else: "badge-ghost"}"}>
            {if is_nil(row.entry.archived_at), do: "enabled", else: "disabled"}
          </span>
        </:col>
        <:col :let={row} label="Categories">
          <div class="flex flex-wrap gap-1">
            <span :for={category <- row.categories} class="badge badge-outline badge-sm">
              {category.display_name}
            </span>
          </div>
        </:col>
        <:col :let={row} label="Assignments">{row.assignment_count}</:col>
        <:col :let={row} label="Updated" class="text-sm text-base-content/70">
          {Calendar.strftime(row.entry.updated_at, "%Y-%m-%d %H:%M")}
        </:col>
        <:action :let={row}>
          <div class="join" role="group" aria-label={"Actions for #{row.entry.name}"}>
            <.bar_button
              icon="hero-clipboard-mini"
              label="Copy path"
              target={row.entry.name}
              onclick={"navigator.clipboard.writeText('#{row.entry.command_path}')"}
            />
            <.bar_button
              icon="hero-paper-airplane-mini"
              label="Assign"
              target={row.entry.name}
              phx-click="assign_shortcut"
              phx-value-id={row.entry.id}
            />
            <%= if @can_manage do %>
              <.link
                patch={~p"/scripts/command-policies/#{row.entry.id}/edit?#{@current_params}"}
                class={bar_button_class(false)}
                data-tip="Edit"
                aria-label={"Edit #{row.entry.name}"}
              >
                <.icon name="hero-pencil-square-mini" class="size-4" />
              </.link>
              <.bar_button
                icon="hero-square-2-stack-mini"
                label="Duplicate"
                target={row.entry.name}
                phx-click="duplicate_entry"
                phx-value-id={row.entry.id}
              />
              <.bar_button
                :if={is_nil(row.entry.archived_at)}
                icon="hero-no-symbol-mini"
                label="Disable"
                target={row.entry.name}
                danger
                phx-click="archive_entry"
                phx-value-id={row.entry.id}
                data-confirm="Disable this command entry?"
              />
            <% end %>
          </div>
        </:action>
      </.table>
    </div>
  <% end %>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="command-entry-modal"
  show
  on_cancel={JS.patch(~p"/scripts/command-policies?#{@current_params}")}
>
  <.live_component
    module={NixstasisWeb.CommandPolicyLive.FormComponent}
    id={(@entry && @entry.id) || :new}
    title={@page_title}
    action={@live_action}
    entry={@entry}
    can_manage={@can_manage}
    patch={~p"/scripts/command-policies?#{@current_params}"}
  />
</.modal>

<.modal
  :if={@live_action in [:new_category, :edit_category]}
  id="category-modal"
  show
  on_cancel={JS.patch(~p"/scripts/command-policies?#{@current_params}")}
>
  <.live_component
    module={NixstasisWeb.CommandPolicyLive.CategoryFormComponent}
    id={(@category && @category.id) || :new_category}
    title={@page_title}
    action={@live_action}
    category={@category}
    patch={~p"/scripts/command-policies?#{@current_params}"}
  />
</.modal>

<.confirm_modal
  :if={@category_to_delete}
  id="delete-category-modal"
  title="Delete Category"
  on_confirm={JS.push("delete_category")}
  on_cancel={JS.push("cancel_delete_category")}
>
  Delete <span class="font-bold">{@category_to_delete.display_name}</span>? Its tag is removed from command entries.
</.confirm_modal>
