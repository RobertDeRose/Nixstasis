<div class="p-4 space-y-4">
  <div class="flex items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold">Command Policies</h1>
      <p class="text-sm text-base-content/60">
        Manage allowed command names and absolute paths for device policy delivery.
      </p>
    </div>

    <div class="flex gap-2">
      <.link navigate={~p"/scripts"} class="btn btn-sm btn-ghost">Back to Scripts</.link>
      <%= if @can_manage do %>
        <.link patch={~p"/scripts/command-policies/new?#{@current_params}"} class="btn btn-sm btn-primary">
          New Command Entry
        </.link>
      <% end %>
    </div>
  </div>

  <div class="grid gap-3 rounded-box border border-base-300 bg-base-100 p-4 md:grid-cols-5">
    <input
      type="text"
      name="search"
      value={@current_params["search"]}
      placeholder="Search name, path, description"
      class="input input-bordered md:col-span-2"
      phx-change="filter"
    />

    <select name="category_id" class="select select-bordered" phx-change="filter">
      <option value="">All categories</option>
      <option
        :for={category <- @categories}
        value={category.id}
        selected={@current_params["category_id"] == category.id}
      >
        {category.display_name}
      </option>
    </select>

    <select name="status" class="select select-bordered" phx-change="filter">
      <option value="">All statuses</option>
      <option value="enabled" selected={@current_params["status"] == "enabled"}>Enabled</option>
      <option value="archived" selected={@current_params["status"] == "archived"}>Disabled</option>
    </select>

    <div class="flex gap-2">
      <select name="assigned" class="select select-bordered flex-1" phx-change="filter">
        <option value="">All assignment states</option>
        <option value="assigned" selected={@current_params["assigned"] == "assigned"}>Assigned</option>
        <option value="unassigned" selected={@current_params["assigned"] == "unassigned"}>Unassigned</option>
      </select>
      <button type="button" class="btn btn-ghost" phx-click="clear_filters">Clear</button>
    </div>
  </div>

  <%= if @selected_assignment_entry_id do %>
    <div class="alert alert-info">
      <.icon name="hero-arrow-right-circle" class="size-5" />
      <span>
        Entry preselected for the upcoming assignment wizard:
        <span class="font-semibold">{@selected_assignment_entry_id}</span>
      </span>
    </div>
  <% end %>

  <section class="rounded-box border border-base-300 bg-base-100 p-4">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Categories</h2>
      <%= if @can_manage do %>
        <.link patch={~p"/scripts/command-policies/categories/new?#{@current_params}"} class="btn btn-sm btn-primary">
          New Category
        </.link>
      <% end %>
    </div>
    <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
      <div :for={category <- @categories} class="rounded-box border border-base-300 p-3">
        <div class="flex items-start justify-between gap-2">
          <div>
            <div class="font-medium">{category.display_name}</div>
            <div class="text-xs text-base-content/60">{category.slug}</div>
          </div>
          <button
            type="button"
            class="btn btn-xs btn-ghost"
            phx-click="assign_category_shortcut"
            phx-value-id={category.id}
          >
            Assign
          </button>
        </div>
        <p class="mt-2 text-sm text-base-content/70">{category.description}</p>
        <div class="mt-3 flex flex-wrap gap-2 text-xs text-base-content/60">
          <span>{category_entry_count(category.id)} entries</span>
          <span>{category_assignment_count(category.id)} active assignments</span>
        </div>
        <%= if @can_manage do %>
          <div class="mt-3 flex gap-2">
            <.link
              patch={~p"/scripts/command-policies/categories/#{category.id}/edit?#{@current_params}"}
              class="btn btn-xs btn-ghost"
            >
              Edit
            </.link>
            <button
              type="button"
              class="btn btn-xs btn-ghost text-error"
              phx-click="delete_category"
              phx-value-id={category.id}
              data-confirm={"Delete #{category.display_name}? This removes the tag from command entries."}
            >
              Delete
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="rounded-box border border-base-300 bg-base-100 p-4">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Device Assignments</h2>
      <button type="button" class="btn btn-sm btn-ghost" phx-click="refresh">Refresh</button>
    </div>

    <.form for={%{}} as={:assignment} phx-submit="preview_assignment" class="grid gap-3 md:grid-cols-6">
      <select name="assignment[device_ids][]" class="select select-bordered" multiple>
        <option :for={device <- @devices} value={device.id}>{device.product_name || device.mac_address}</option>
      </select>
      <select name="assignment[entry_ids][]" class="select select-bordered" multiple>
        <option :for={row <- @entries} value={row.entry.id} selected={row.entry.id in @assignment_form["entry_ids"]}>
          {row.entry.name}
        </option>
      </select>
      <select name="assignment[category_ids][]" class="select select-bordered" multiple>
        <option
          :for={category <- @categories}
          value={category.id}
          selected={category.id in @assignment_form["category_ids"]}
        >
          {category.display_name}
        </option>
      </select>
      <select name="assignment[catalog_command_ids][]" class="select select-bordered" multiple>
        <option
          :for={command <- @catalog_commands}
          value={command.id}
          selected={command.id in @assignment_form["catalog_command_ids"]}
        >
          {command.name} · catalog
        </option>
      </select>
      <select name="assignment[catalog_category_ids][]" class="select select-bordered" multiple>
        <option
          :for={category <- @catalog_categories}
          value={category.id}
          selected={category.id in @assignment_form["catalog_category_ids"]}
        >
          {category.display_name} · catalog category
        </option>
      </select>
      <button type="submit" class="btn btn-primary">Preview</button>
    </.form>

    <%= if @assignment_preview do %>
      <div class="mt-4 rounded-box border border-base-300 p-4">
        <div class="font-semibold">Preview</div>
        <div class="mt-2 text-sm">
          Devices: {length(@assignment_preview.device_ids)} · Commands: {map_size(@assignment_preview.commands)}
        </div>
        <%= if @assignment_preview.catalog.devices != %{} do %>
          <div class="mt-3 overflow-x-auto">
            <table class="table table-xs">
              <thead>
                <tr>
                  <th>Device</th>
                  <th>Catalog command</th>
                  <th>Compatibility</th>
                  <th>Catalog path</th>
                  <th>Details</th>
                </tr>
              </thead>
              <tbody>
                <%= for {device_id, device_preview} <- @assignment_preview.catalog.devices do %>
                  <tr :for={{name, result} <- device_preview.commands}>
                    <td>{device_id}</td>
                    <td>{name}</td>
                    <td><span class="badge badge-outline">{result.status}</span></td>
                    <td><code class="text-xs">{Map.get(result, :command_path, "-")}</code></td>
                    <td class="max-w-md text-xs">
                      <div :if={Map.get(result, :package_name)}>Package: {result.package_name}</div>
                      <div :if={Map.get(result, :install_hint)}>Install: {result.install_hint}</div>
                      <div :if={Map.get(result, :observed_path)}>Observed path: {result.observed_path}</div>
                      <div :if={Map.get(result, :manual_path)}>Manual path: {result.manual_path}</div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
        <%= if @assignment_preview.conflicts == [] and @assignment_preview.catalog_blockers == [] do %>
          <button class="btn btn-sm btn-primary mt-3" phx-click="confirm_assignment">Confirm and queue</button>
        <% else %>
          <div class="alert alert-error mt-3">
            Conflicts or incompatible catalog commands detected; remove blocked sources before confirming.
          </div>
        <% end %>
        <pre class="mt-3 max-h-48 overflow-auto rounded bg-base-200 p-3 text-xs">{Jason.encode!(%{manual: @assignment_preview.payload, catalog: @assignment_preview.catalog_commands, catalog_blockers: @assignment_preview.catalog_blockers}, pretty: true)}</pre>
      </div>
    <% end %>

    <div class="mt-4 overflow-x-auto">
      <table class="table table-sm">
        <thead>
          <tr>
            <th>Device</th>
            <th>Revision</th>
            <th>Status</th>
            <th>Last result</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={assignment <- @assignments}>
            <td>{assignment.device_id}</td>
            <td>{assignment.revision}</td>
            <td>
              <span class="badge badge-outline">{assignment.status}</span>
              <span :if={assignment.drift_warning} class="badge badge-warning">drift</span>
            </td>
            <td>
              {case latest_result(@delivery_results, assignment.id) do
                nil -> "pending/offline"
                result -> "#{result.status}: #{result.failure_reason || "ok"}"
              end}
            </td>
            <td class="flex flex-wrap gap-2">
              <button class="btn btn-xs btn-ghost" phx-click="retry_assignment" phx-value-id={assignment.id}>
                Retry/resend
              </button>
              <button class="btn btn-xs btn-ghost" phx-click="toggle_drift_warning" phx-value-id={assignment.id}>
                Toggle drift
              </button>
              <button
                class="btn btn-xs btn-ghost text-error"
                phx-click="revoke_all"
                phx-value-device-id={assignment.device_id}
                data-confirm="Queue deny-all policy for this device?"
              >
                Revoke all
              </button>
              <details>
                <summary class="btn btn-xs btn-ghost">Raw</summary>
                <pre class="max-w-md overflow-auto rounded bg-base-200 p-2 text-xs">{Jason.encode!(assignment.resolved_policy, pretty: true)}</pre>
              </details>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <%= if @entries == [] do %>
    <div class="rounded-box border border-dashed border-base-300 bg-base-100 p-10 text-center text-base-content/60">
      No command entries found.
    </div>
  <% else %>
    <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
      <table class="table table-zebra">
        <thead>
          <tr>
            <th>Name</th>
            <th>Path</th>
            <th>Status</th>
            <th>Categories</th>
            <th>Assignments</th>
            <th>Updated</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr :for={row <- @entries}>
            <td class="font-medium">{row.entry.name}</td>
            <td>
              <code class="text-xs">{row.entry.command_path}</code>
            </td>
            <td>
              <span class={"badge #{if is_nil(row.entry.archived_at), do: "badge-success", else: "badge-ghost"}"}>
                {if is_nil(row.entry.archived_at), do: "enabled", else: "disabled"}
              </span>
            </td>
            <td>
              <div class="flex flex-wrap gap-1">
                <span :for={category <- row.categories} class="badge badge-outline badge-sm">
                  {category.display_name}
                </span>
              </div>
            </td>
            <td>{row.assignment_count}</td>
            <td class="text-sm text-base-content/60">{Calendar.strftime(row.entry.updated_at, "%Y-%m-%d %H:%M")}</td>
            <td>
              <div class="flex flex-wrap gap-2">
                <button
                  type="button"
                  class="btn btn-xs btn-ghost"
                  onclick={"navigator.clipboard.writeText('#{row.entry.command_path}')"}
                >
                  Copy path
                </button>
                <button
                  type="button"
                  class="btn btn-xs btn-ghost"
                  phx-click="assign_shortcut"
                  phx-value-id={row.entry.id}
                >
                  Assign
                </button>
                <%= if @can_manage do %>
                  <.link
                    patch={~p"/scripts/command-policies/#{row.entry.id}/edit?#{@current_params}"}
                    class="btn btn-xs btn-ghost"
                  >
                    Edit
                  </.link>
                  <button
                    type="button"
                    class="btn btn-xs btn-ghost"
                    phx-click="duplicate_entry"
                    phx-value-id={row.entry.id}
                  >
                    Duplicate
                  </button>
                  <%= if is_nil(row.entry.archived_at) do %>
                    <button
                      type="button"
                      class="btn btn-xs btn-ghost text-error"
                      phx-click="archive_entry"
                      phx-value-id={row.entry.id}
                      data-confirm="Disable this command entry?"
                    >
                      Disable
                    </button>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<.modal
  :if={@live_action in [:new, :edit]}
  id="command-entry-modal"
  show
  on_cancel={JS.patch(~p"/scripts/command-policies?#{@current_params}")}
>
  <.live_component
    module={NixstasisWeb.CommandPolicyLive.FormComponent}
    id={@entry[:id] || :new}
    title={@page_title}
    action={@live_action}
    entry={@entry}
    can_manage={@can_manage}
    patch={~p"/scripts/command-policies?#{@current_params}"}
  />
</.modal>

<.modal
  :if={@live_action in [:new_category, :edit_category]}
  id="category-modal"
  show
  on_cancel={JS.patch(~p"/scripts/command-policies?#{@current_params}")}
>
  <.live_component
    module={NixstasisWeb.CommandPolicyLive.CategoryFormComponent}
    id={@category[:id] || :new_category}
    title={@page_title}
    action={@live_action}
    category={@category}
    patch={~p"/scripts/command-policies?#{@current_params}"}
  />
</.modal>
