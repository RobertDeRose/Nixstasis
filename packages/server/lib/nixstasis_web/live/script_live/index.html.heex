<div class="ui-page-shell">
  <.header>
    Scripts
    <:actions>
      <.link navigate={~p"/scripts/command-policies"} class="btn btn-sm btn-ghost">
        Command Policies
      </.link>
      <button :if={@can_manage} phx-click="create_script" class="btn btn-sm btn-primary">
        New Script
      </button>
    </:actions>
  </.header>

  <%= if @scripts == [] do %>
    <div class="text-center py-12 text-base-content/70">
      <.icon name="hero-document-text" class="size-12 mx-auto mb-4" />
      <p class="text-lg">No scripts yet</p>
      <p class="text-sm">Create your first script to get started</p>
    </div>
  <% else %>
    <.table id="scripts" rows={@scripts}>
      <:col :let={script} label="Name">
        <.link navigate={~p"/scripts/#{script.id}"} class="link link-hover font-medium">
          {script.name}
        </.link>
      </:col>
      <:col :let={script} label="Status">
        <span class={"badge #{status_badge_class(script.status)}"}>{script.status}</span>
      </:col>
      <:col :let={script} label="Version">
        <%= if script.front_matter["version"] do %>
          {script.front_matter["version"]}
        <% else %>
          <span class="text-base-content/70">—</span>
        <% end %>
      </:col>
      <:col :let={script} label="Updated" class="text-sm text-base-content/70">
        {Calendar.strftime(script.updated_at, "%Y-%m-%d %H:%M")}
      </:col>
      <:action :let={script}>
        <.link navigate={~p"/scripts/#{script.id}"} class="btn btn-xs btn-ghost">Edit</.link>
        <button
          :if={@can_manage and script.status != :archived}
          phx-click="archive_script"
          phx-value-id={script.id}
          class="btn btn-xs btn-ghost text-error"
          data-confirm="Archive this script?"
        >
          Archive
        </button>
      </:action>
    </.table>
  <% end %>
</div>
