<!DOCTYPE html>
<html lang="en">
  <head>
    {Application.get_env(:live_debugger, :live_debugger_tags)}

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Nixstasis" suffix=" · Nixstasis">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script
      data-palettes={Enum.join(NixstasisWeb.Theme.palette_values(), " ")}
      data-default-palette={NixstasisWeb.Theme.default_palette()}
      data-highlights={Enum.join(NixstasisWeb.Theme.highlight_values(), " ")}
      data-default-highlight={NixstasisWeb.Theme.default_highlight()}
    >
      (() => {
        const root = document.documentElement;
        const palettes = document.currentScript.dataset.palettes.split(" ");
        const defaultPalette = document.currentScript.dataset.defaultPalette;
        const highlights = document.currentScript.dataset.highlights.split(" ");
        const defaultHighlight = document.currentScript.dataset.defaultHighlight;
        const syncThemeButtons = () => {
          const theme = root.getAttribute("data-theme") || "system";
          document.querySelectorAll("[data-phx-theme]").forEach((button) =>
            button.setAttribute("aria-pressed", String(button.dataset.phxTheme === theme))
          );
        };
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            root.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            root.setAttribute("data-theme", theme);
          }
          syncThemeButtons();
        };
        const setPalette = (palette) => {
          const value = palettes.includes(palette) ? palette : defaultPalette;
          localStorage.setItem("phx:palette", value);
          root.setAttribute("data-palette", value);
          document.querySelectorAll("[data-palette-select]").forEach((select) => select.value = value);
        };
        const setHighlight = (highlight) => {
          const value = highlights.includes(highlight) ? highlight : defaultHighlight;
          localStorage.setItem("phx:highlight", value);
          root.setAttribute("data-highlight", value);
          document.querySelectorAll("[data-highlight-select]").forEach((input) => input.checked = input.value === value);
        };
        if (!root.hasAttribute("data-theme")) setTheme(localStorage.getItem("phx:theme") || "system");
        if (!root.hasAttribute("data-highlight")) setHighlight(localStorage.getItem("phx:highlight"));
        if (!root.hasAttribute("data-palette")) setPalette(localStorage.getItem("phx:palette"));
        window.addEventListener("storage", (e) => {
          if (e.key === "phx:theme") setTheme(e.newValue || "system");
          if (e.key === "phx:palette") setPalette(e.newValue);
          if (e.key === "phx:highlight") setHighlight(e.newValue);
        });

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
        window.addEventListener("change", (e) => {
          if (e.target.matches("[data-palette-select]")) setPalette(e.target.value);
          if (e.target.matches("[data-highlight-select]")) setHighlight(e.target.value);
        });
        const syncControls = () => {
          setPalette(localStorage.getItem("phx:palette"));
          setHighlight(localStorage.getItem("phx:highlight"));
          syncThemeButtons();
        };
        window.addEventListener("DOMContentLoaded", syncControls);
        window.addEventListener("phx:page-loading-stop", syncControls);
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
