# vim: set ts=4 sw=4 et:
{
	email RobertDeRose@users.noreply.github.com
	log {
		format console
	}
	on_demand_tls {
		ask http://localhost:8000/permit_tls
	}

	# Order is important - security must process before reverse_proxy
	order authenticate before respond
	order authorize before reverse_proxy

	# Security configuration
	security {
		# OAuth identity provider for Azure/Entra ID
		oauth identity provider azure {
			realm azure
			driver azure
			client_id {$CLIENT_ID}
			client_secret {$CLIENT_SECRET}
			tenant_id {$TENANT_ID}
			scopes openid email profile
		}

		# Authentication portal
		authentication portal myportal {
			crypto default token lifetime 3600
			crypto key sign-verify {$JWT_KEY}
			enable identity provider azure

			cookie domain device.<domain>

			# transform user {
			#     match origin azure
			#     action add role authp/user
			# }

			ui {
				theme basic
				#template login {env.HOME}/.local/caddy/ui/login.template
				template login /var/www/auth/login.template
				template portal /var/www/auth/portal.template
				# Logo configuration
				static_asset "assets/images/logo.svg" "image/svg+xml" /var/www/auth/icon.svg

				# Links displayed on the portal page after login
				links {
					"Nixstasis" https://nixstasis.device.<domain> icon "las la-server"
				}
			}
		}

		# Authorization policy for Entra ID auth
		authorization policy entra_policy {
			set auth url https://auth.device.<domain>
			#allow roles authp/user authp/admin
			allow roles *
			crypto key verify {$JWT_KEY}
			validate bearer header
			inject headers with claims
		}
	}
}

# Authentication portal site
auth.device.<domain> {
	tls {
		on_demand
	}

	authenticate with myportal
}

nixstasis.device.<domain> {
	tls {
		on_demand
	}

	root * /var/www/nixstasis
	encode

	handle /api/v1/* {
		reverse_proxy localhost:8000
	}

	# Static assets - no auth
	@static_assets {
		path /assets/* /favicon* /*.jpg /*.png /style.css /sitemap.xml
	}

	handle @static_assets {
		file_server
	}

	# Everything else requires auth
	handle {
		# Serves the Nixstasis application directly
		@static {
			file {
				try_files {path} {path}/ {path}/index.html
			}
		}

		handle @static {
			authorize with entra_policy
			encode
			file_server
		}

		# Handle the WebSocket /_event and routes like /ping
		handle {
			authorize with entra_policy
			reverse_proxy localhost:8000
		}
	}
}

# AlarmBox sites use their own Authentication
*.device.<domain> {
	tls {
		on_demand
	}

	reverse_proxy localhost:8080
}
