# vim: set ts=4 sw=4 et:
{
	# Global email address used for Let's Encrypt certificate registration
	email RobertDeRose@users.noreply.github.com

	# Configure Caddy's global logging to output to stdout in console format
	log {
		format console
	}

	# On-Demand TLS Configuration
	# Caddy will ask the upstream service if it should obtain a certificate for a given domain
	# This prevents abuse by only issuing certs for allowed domains
	on_demand_tls {
		ask http://localhost:4000/api/v1/check_domain
	}

	# Order directives ensure the security plugin (authp) runs before standard Caddy directives
	# 'authenticate' validates credentials/sessions
	# 'authorize' enforces access policies
	order authenticate before respond
	order authorize before reverse_proxy

	# Security configuration using the authp plugin (AuthCrunch)
	security {
		# OAuth 2.0 Identity Provider configuration for Microsoft Entra ID (formerly Azure AD)
		# This handles the handshake with Microsoft to get user identity
		oauth identity provider azure {
			realm azure
			driver azure
			client_id {$CLIENT_ID}
			client_secret {$CLIENT_SECRET}
			tenant_id {$TENANT_ID}
			scopes openid email profile
		}

		# Authentication Portal Configuration
		# Defines how the login page looks and behaves
		authentication portal myportal {
			# Token lifetime set to 1 hour (3600 seconds)
			crypto default token lifetime 3600
			# JWT signing key for validating tokens
			crypto key sign-verify {$JWT_KEY}
			# Enable the Azure provider defined above
			enable identity provider azure

			# Cookie domain set to the root domain so auth works across subdomains
			# e.g., auth.ab... and nixstasis.ab... share the session
			cookie domain device.<domain>

			# transform user {
			#     match origin azure
			#     action add role authp/user
			# }

			# UI Customization for the login portal
			ui {
				theme basic
				# Custom templates for login and portal pages
				template login /var/www/auth/login.template
				template portal /var/www/auth/portal.template
				# Logo configuration
				static_asset "assets/images/logo.svg" "image/svg+xml" /var/www/auth/icon.svg

				# Links displayed on the portal page after login
				links {
					"Nixstasis" https://nixstasis.device.<domain> icon "las la-server"
					"FRP Admin" https://frp-router.device.<domain> icon "las la-ethernet"
				}
			}
		}

		# Authorization Policy
		# Defines WHO can access resources protected by this policy
		authorization policy entra_policy {
			# Where to redirect unauthenticated users
			set auth url https://auth.device.<domain>

			# Allow any authenticated user with a valid role (currently wildcard)
			allow roles *

			# Verify the JWT token signature using the shared key
			crypto key verify {$JWT_KEY}

			# Look for the token in the Authorization: Bearer header
			validate bearer header

			# Pass user claims (email, name, etc.) to the upstream app via headers
			inject headers with claims
		}
	}
}

# Authentication Portal Site
# This subdomain handles the actual login flow and callbacks
auth.device.<domain> {
	tls {
		# Obtain certificates on demand (checked via global on_demand_tls ask)
		on_demand
	}

	# Attach the 'myportal' configuration to this site
	authenticate with myportal
}

# Nixstasis Application Site
# The main dashboard and API server
nixstasis.device.<domain> {
	tls {
		on_demand
	}

	# Serve static files from this directory
	root * /var/www/nixstasis
	encode

	# API Request Handling
	# Proxy /api/v1/* requests directly to the backend Python server
	# No authentication required here (handled by the app or script logic?)
	# NOTE: Currently no 'authorize' directive, implies public API or app-handled auth
	handle /api/v1/* {
		reverse_proxy localhost:8000
	}

	# Static Assets Handling
	# Publicly accessible assets (CSS, JS, Images) - No Auth Required
	@static_assets {
		path /assets/* /favicon* /*.jpg /*.png /style.css /sitemap.xml
	}

	handle @static_assets {
		file_server
	}

	# Protected Content Handling
	# Everything else requires authentication via 'entra_policy'
	handle {
		# SPA (Single Page App) Support
		# Try to serve file, directory, or fall back to index.html for client-side routing
		@static {
			file {
				try_files {path} {path}/ {path}/index.html
			}
		}

		# Serve protected static files (the React/Reflex frontend)
		handle @static {
			authorize with entra_policy
			encode
			file_server
		}

		# Handle WebSocket connections (/_event) and other dynamic routes
		# Proxied to the backend server, protected by auth policy
		handle {
			authorize with entra_policy
			reverse_proxy localhost:8000
		}
	}
}

# FRP Router Admin Interface
# Proxies to the FRPS (Fast Reverse Proxy Server) dashboard
frp-router.device.<domain> {
	tls {
		on_demand
	}

	# Protect the admin dashboard with the same Entra ID policy
	authorize with entra_policy
	reverse_proxy localhost:8081
}

# Wildcard Subdomains for AlarmBox Devices
# Matches any other subdomain (e.g., atom-12345.device.<domain>)
# Used for accessing individual devices remotely via the FRP tunnel
*.device.<domain> {
	tls {
		on_demand
	}

	# Proxy to the HTTP tunnel port (8080) defined in frps.toml
	# Note: No 'authorize' directive here - Devices/FRP likely handle their own auth
	# or rely on the tunnel security.
	reverse_proxy localhost:8080
}
