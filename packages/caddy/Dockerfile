ARG CADDY_VERSION=2.11.2
ARG CADDY_SECURITY_VERSION=e17d199a40949dc9d207b211413f6dedf71213b9
ARG CADDY_BUILDER_IMAGE_DIGEST=sha256:10ed0251c5cd1dbb4db0b71ad43121147961a51adfec35febce2c93ea25c24f4
ARG CADDY_RUNNER_IMAGE_DIGEST=sha256:25cdc846626b62d05f6b633b9b40c2c9f6ef89b515dc76133cefd920f7dbe562

FROM caddy:${CADDY_VERSION}-builder@${CADDY_BUILDER_IMAGE_DIGEST} AS builder

ARG CADDY_VERSION
ARG CADDY_SECURITY_VERSION

RUN xcaddy build "v${CADDY_VERSION}" \
    --with github.com/greenpau/caddy-security@${CADDY_SECURITY_VERSION} && \
    go version -m /usr/bin/caddy

ARG CADDY_VERSION=2.11.2
ARG CADDY_RUNNER_IMAGE_DIGEST

FROM caddy:${CADDY_VERSION}@${CADDY_RUNNER_IMAGE_DIGEST}

COPY --from=builder /usr/bin/caddy /usr/bin/caddy
