DATABASE_URL=ecto://postgres:postgres@postgres/nixstasis
SECRET_KEY_BASE=replace-me-with-mix-phx-gen-secret
PHX_HOST=nixstasis.localhost
PORT=4000
BASE_DOMAIN=localhost
NIXSTASIS_TLS_OBSERVATIONS_ENABLED=true
NIXSTASIS_TLS_OBSERVATIONS_TOKEN=replace-me-with-a-local-validation-token
NIXSTASIS_FORCE_SSL=false
ACME_EMAIL=dev-null@nixstasis.localhost
CLIENT_ID=replace-me
CLIENT_SECRET=replace-me
TENANT_ID=replace-me
JWT_KEY=replace-me
AUTHORIZED_ROLES=nixstasis-operator
AUTHORIZED_GROUPS=00000000-0000-0000-0000-000000000000
FRPS_BIND_PORT=7000
FRPS_AUTH_TOKEN=replace-me-with-a-strong-frp-client-token
FRPS_HTTP_PORT=8080
FRPS_DASHBOARD_PORT=8081
FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=replace-me-with-a-strong-frps-dashboard-password
FRPS_TCPMUX_PORT=2022
LAPTOP_SSH_PORT=2222
LAPTOP_SSH_IMAGE_REF=lscr.io/linuxserver/openssh-server:version-9.9_p2-r0@sha256:replace-with-openssh-server-digest
POSTGRES_VERSION=18.3-alpine
POSTGRES_IMAGE_DIGEST=sha256:replace-with-postgres-digest
POSTGRES_DB=nixstasis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
NIXSTASIS_SERVER_IMAGE_REF=nixstasis-server:laptop
NIXSTASIS_CADDY_IMAGE_REF=nixstasis-caddy:laptop
NIXSTASIS_FRPS_IMAGE_REF=nixstasis-frps:laptop
