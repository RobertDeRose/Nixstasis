# Nixstasis local development environment

# --- Server ---
DATABASE_URL=ecto://postgres:postgres@postgres/nixstasis
SECRET_KEY_BASE=dev-secret-key-base-change-for-shared-environments-0123456789abcdef0123456789abcdef
PHX_HOST=nixstasis.localhost
PORT=4000
BASE_DOMAIN=localhost
CHECK_ORIGIN_EXTRA=nixstasis.localhost,127.0.0.1:4000
NIXSTASIS_FORCE_SSL=false
NIXSTASIS_TLS_OBSERVATIONS_ENABLED=true
NIXSTASIS_TLS_OBSERVATIONS_TOKEN=dev-tls-observations-token
NIXSTASIS_E2E_ENABLED=true
NIXSTASIS_LOCAL_BROWSER_AUTH_FALLBACK=true
NIXSTASIS_SESSION_COOKIE_SECURE=false

# --- Bind host ---
BIND_HOST=127.0.0.1
PHOENIX_BIND_HOST=127.0.0.1

# --- Caddy/AuthCrunch ---
CADDY_CONFIG=./caddy/Caddyfile.dev
ACME_EMAIL=dev@example.com
CLIENT_ID=dev-client-id
CLIENT_SECRET=dev-client-secret
TENANT_ID=dev-tenant-id
JWT_KEY=dev-jwt-signing-key-change-for-shared-environments
AUTHORIZED_ROLES=nixstasis/viewer nixstasis/operator nixstasis/admin
AUTHORIZED_GROUPS=local-viewer-group local-operator-group local-admin-group
NIXSTASIS_VIEWER_GROUPS=local-viewer-group
NIXSTASIS_OPERATOR_GROUPS=local-operator-group
NIXSTASIS_ADMIN_GROUPS=local-admin-group

# --- FRP ---
FRP_VERSION=0.68.1
FRP_LINUX_AMD64_SHA256=4a4e88987d39561e1b3b3b23d0ede48a457eebf76a87231999957e870f5f02b6
FRP_LINUX_ARM64_SHA256=e7ad15b0cfe4cf0125df4217778b66cb4426179270967b59900ecb2362d8cd01
FRPS_BIND_PORT=7000
FRPS_AUTH_TOKEN=dev-frps-token
FRPS_HTTP_PORT=8080
FRPS_DASHBOARD_PORT=8081
FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=dev-frps-dashboard-password
FRPS_TCPMUX_PORT=2022
NIXSTASIS_SSH_FRP_HOST=frps
NIXSTASIS_FRP_AUTH_TOKEN=dev-frps-token
NIXSTASIS_FRP_HTTP_LOCAL_ADDR=127.0.0.1:443
NIXSTASIS_SIMULATOR_HTTP_ENABLED=true

# --- Postgres ---
POSTGRES_VERSION=18.3-alpine
POSTGRES_DB=nixstasis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Images ---
NIXSTASIS_SERVER_IMAGE_REF=nixstasis-server:dev
NIXSTASIS_CADDY_IMAGE_REF=nixstasis-caddy:dev
NIXSTASIS_FRPS_IMAGE_REF=nixstasis-frps:dev
NIXSTASIS_CLIENT_IMAGE_REF=nixstasis-client:dev
