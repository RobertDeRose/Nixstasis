{
  email {$ACME_EMAIL}

  log {
    format console
  }

  on_demand_tls {
    ask http://nixstasis:{$PORT}/api/v1/check_domain
  }

  order authenticate before respond
  order authorize before reverse_proxy

  security {
    oauth identity provider azure {
      realm azure
      driver azure
      client_id {$CLIENT_ID}
      client_secret {$CLIENT_SECRET}
      tenant_id {$TENANT_ID}
      scopes openid email profile
    }

    authentication portal nixstasis_portal {
      crypto default token lifetime 3600
      crypto key sign-verify {$JWT_KEY}
      enable identity provider azure
      cookie domain {$BASE_DOMAIN}

      transform user {
        match groups {$NIXSTASIS_VIEWER_GROUPS}
        action add role nixstasis/viewer
      }

      transform user {
        match groups {$NIXSTASIS_OPERATOR_GROUPS}
        action add role nixstasis/operator
      }

      transform user {
        match groups {$NIXSTASIS_ADMIN_GROUPS}
        action add role nixstasis/admin
      }
    }

    authorization policy entra_policy {
      set auth url https://auth.{$BASE_DOMAIN}
      allow roles {$AUTHORIZED_ROLES}
      allow groups {$AUTHORIZED_GROUPS}
      crypto key verify {$JWT_KEY}
      validate bearer header
      inject headers with claims
    }
  }
}

auth.{$BASE_DOMAIN} {
  tls {
    on_demand
  }

  authenticate with nixstasis_portal
}

nixstasis.{$BASE_DOMAIN} {
  tls {
    on_demand
  }

  @frp_internal path /internal/frp/*

  # Prevent hop-by-hop cleanup from removing verified claims after authorization.
  @unsafe_connection header_regexp Connection `(?i)(^|,)[ \t]*x-(token-[^, \t]*|nixstasis-proxy-token)[ \t]*(,|$)`

  # Remove client claims before AuthCrunch injects verified operator claims.
  request_header -X-Token-*

  @device_registration {
    method POST
    path /api/v1/devices/register /api/json/device_runtime/devices/register
  }

  @device_heartbeat {
    method POST
    path_regexp ^/api/(v1|json/device_runtime)/devices/[^/]+/heartbeat$
  }

  @device_command_results {
    method POST
    path_regexp ^/api/(v1|json/device_runtime)/devices/[^/]+/command_results$
  }

  @device_command_payload {
    method GET
    path_regexp ^/api/(v1|json/device_runtime)/devices/[^/]+/command_payloads/[^/]+$
  }

  @e2e_api {
    path /e2e/*
  }

  # Explicit order keeps rejection ahead of all device and operator handlers.
  route {
    respond @unsafe_connection 400
    respond @frp_internal "Not Found" 404

    handle @device_registration {
      reverse_proxy nixstasis:{$PORT} {
        header_up -X-Token-*
        header_up X-Nixstasis-Proxy-Token {$NIXSTASIS_PROXY_AUTH_TOKEN}
        header_up X-Nixstasis-Client-IP {http.request.remote.host}
      }
    }

    handle @device_heartbeat {
      reverse_proxy nixstasis:{$PORT} {
        header_up -X-Token-*
        header_up X-Nixstasis-Proxy-Token {$NIXSTASIS_PROXY_AUTH_TOKEN}
        header_up X-Nixstasis-Client-IP {http.request.remote.host}
      }
    }

    handle @device_command_results {
      reverse_proxy nixstasis:{$PORT} {
        header_up -X-Token-*
        header_up X-Nixstasis-Proxy-Token {$NIXSTASIS_PROXY_AUTH_TOKEN}
        header_up X-Nixstasis-Client-IP {http.request.remote.host}
      }
    }

    handle @device_command_payload {
      reverse_proxy nixstasis:{$PORT} {
        header_up -X-Token-*
        header_up X-Nixstasis-Proxy-Token {$NIXSTASIS_PROXY_AUTH_TOKEN}
        header_up X-Nixstasis-Client-IP {http.request.remote.host}
      }
    }

    handle @e2e_api {
      reverse_proxy nixstasis:{$PORT} {
        header_up -X-Token-*
        header_up X-Nixstasis-Proxy-Token {$NIXSTASIS_PROXY_AUTH_TOKEN}
        header_up X-Nixstasis-Client-IP {http.request.remote.host}
      }
    }

    handle {
      authorize with entra_policy
      reverse_proxy nixstasis:{$PORT} {
        header_up X-Nixstasis-Proxy-Token {$NIXSTASIS_PROXY_AUTH_TOKEN}
        header_up X-Nixstasis-Client-IP {http.request.remote.host}
      }
    }
  }
}

frp-admin.{$BASE_DOMAIN} {
  tls {
    on_demand
  }

  authorize with entra_policy
  reverse_proxy frps:{$FRPS_DASHBOARD_PORT}
}

*.{$BASE_DOMAIN} {
  tls {
    on_demand
  }

  authorize with entra_policy
  header -X-Frame-Options
  reverse_proxy frps:{$FRPS_HTTP_PORT}
}
