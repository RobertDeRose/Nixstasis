{
  log {
    format console
  }
}

auth.{$BASE_DOMAIN} {
  tls internal

  respond "Local dev/test mode uses loopback-only access and Phoenix local auth fallback." 200
}

nixstasis.{$BASE_DOMAIN} {
  tls internal

  @frp_internal path /internal/frp/*

  handle @frp_internal {
    respond "Not Found" 404
  }

  handle {
    reverse_proxy nixstasis:{$PORT} {
      header_up -X-Token-*
      header_up X-Nixstasis-Proxy-Token {$NIXSTASIS_PROXY_AUTH_TOKEN}
    }
  }
}

frp-admin.{$BASE_DOMAIN} {
  tls internal

  reverse_proxy frps:{$FRPS_DASHBOARD_PORT}
}

*.{$BASE_DOMAIN} {
  tls internal

  reverse_proxy frps:{$FRPS_HTTP_PORT}
}
