# Nixstasis production environment
# Copy to .env and replace all placeholder values.

# --- Server ---
DATABASE_URL=ecto://postgres:postgres@postgres/nixstasis
SECRET_KEY_BASE=replace-me-with-mix-phx-gen-secret
PHX_HOST=nixstasis.example.com
PORT=4000
BASE_DOMAIN=example.com

# --- Bind host (0.0.0.0 for prod, 127.0.0.1 for dev) ---
BIND_HOST=0.0.0.0

# --- Caddy ---
CADDY_CONFIG=./caddy/Caddyfile
ACME_EMAIL=ops@example.com
CLIENT_ID=replace-me
CLIENT_SECRET=replace-me
TENANT_ID=replace-me
JWT_KEY=replace-me
AUTHORIZED_ROLES=nixstasis/viewer nixstasis/operator nixstasis/admin
AUTHORIZED_GROUPS=00000000-0000-0000-0000-000000000001 00000000-0000-0000-0000-000000000002 00000000-0000-0000-0000-000000000003
NIXSTASIS_VIEWER_GROUPS=00000000-0000-0000-0000-000000000001
NIXSTASIS_OPERATOR_GROUPS=00000000-0000-0000-0000-000000000002
NIXSTASIS_ADMIN_GROUPS=00000000-0000-0000-0000-000000000003

# --- FRP ---
FRPS_BIND_PORT=7000
FRPS_AUTH_TOKEN=replace-me-with-a-strong-frp-client-token
FRPS_HTTP_PORT=8080
FRPS_DASHBOARD_PORT=8081
FRPS_DASHBOARD_USER=admin
FRPS_DASHBOARD_PASSWORD=replace-me-with-a-strong-frps-dashboard-password
FRPS_TCPMUX_PORT=2022

# --- Postgres ---
POSTGRES_VERSION=18.3-alpine
POSTGRES_DB=nixstasis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me

# --- Images (prod uses pre-built images) ---
NIXSTASIS_SERVER_IMAGE_REF=ghcr.io/robertderose/nixstasis-server@sha256:replace
NIXSTASIS_CADDY_IMAGE_REF=ghcr.io/robertderose/nixstasis-caddy@sha256:replace
NIXSTASIS_FRPS_IMAGE_REF=ghcr.io/robertderose/nixstasis-frps@sha256:replace
NIXSTASIS_CLIENT_IMAGE_REF=ghcr.io/robertderose/nixstasis-client@sha256:replace
