amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Builtins.pkl"

local commit_message_validation: Step = new Step {
  check = #"""
    perl -0pi -e "s/[ \t]+\$//mg; s/(?<=\S) {2,}/ /g" {{commit_msg_file}}
    perl -ne 'print unless /^#/' {{commit_msg_file}} | typos -
    commitlint --edit {{commit_msg_file}}
    """#
}

local commit_message_beads = new Step {
  check = #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      /^(Refs?|Tasks?|Issues?):/ {
        printf "use the canonical Beads: footer instead of: %s\n", $0 > "/dev/stderr"
        failed = 1
      }
      /^Beads:/ {
        beads += 1
        if ($0 !~ /^Beads: [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*(, [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*)*$/) {
          printf "invalid Beads footer: %s\n", $0 > "/dev/stderr"
          failed = 1
        }
      }
      NF { last = $0 }
      END {
        if (beads > 1) {
          print "commit message must contain at most one Beads: footer" > "/dev/stderr"
          failed = 1
        }
        if (beads == 1 && last !~ /^Beads:/) {
          print "Beads: must be the final nonblank line" > "/dev/stderr"
          failed = 1
        }
        exit failed
      }
    ' {{commit_msg_file}}
    """#
}

local commit_message_length = new Step {
  check = #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      {
        line += 1
        limit = line == 1 ? 72 : 100
        if (length($0) > limit) {
          printf "commit message line %d is %d characters; maximum is %d\n", line, length($0), limit > "/dev/stderr"
          failed = 1
        }
      }
      END { exit failed }
    ' {{commit_msg_file}}
    """#
}

local commit_message_scope = new Step {
  check = #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      NF {
        if ($0 ~ /^(feat|fix|perf|refactor)!?: /) {
          print "changelog-visible commit subject must use type(scope): summary" > "/dev/stderr"
          exit 1
        }
        exit 0
      }
    ' {{commit_msg_file}}
    """#
}

local harper_commit_message = (Builtins.harper_commit_message) {
  check = #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      NR == 1 && /^release: v[0-9]+\.[0-9]+\.[0-9]+$/ { next }
      /^Beads: [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*(, [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*)*$/ { next }
      { print }
    ' {{commit_msg_file}} | harper-cli lint --quiet --no-color --user-dict-path .config/harper-dictionary.txt
    """#
}

local linters = new Mapping<String, Step> {
  ["check_byte_order_marker"] = Builtins.check_byte_order_marker
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["check_symlinks"] = Builtins.check_symlinks
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-exec-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = Builtins.detect_private_key
  ["mise"] = Builtins.mise
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["contextlint"] = new Step {
    glob = List("README.md", "docs/**/*.md", "contextlint.config.json")
    check = "contextlint"
  }
  ["docs"] = new Step {
    glob = List("docs/src/**/*.md", "docs/book.toml", "scripts/check-docs.py")
    check = "uv run scripts/check-docs.py && mdbook build docs"
  }
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["markdown-table-formatter"] = new Step {
    glob = List("**/*.md", "**/*.markdown")
    check_diff = "markdown-table-formatter --check {{ files }}"
    fix = "markdown-table-formatter {{ files }}"
  }
  ["rumdl"] = new Step {
    glob = List("**/*.md", "**/*.markdown")
    check = "rumdl check {{ files }}"
    fix = "rumdl check --fix {{ files }}"
  }
  ["typos"] = Builtins.typos
  ["mdbook-lint"] = new Step {
    glob = List("docs/src/**/*.md")
    check_diff = "mdbook-lint lint --config .mdbook-lint.toml {{ files }}"
    fix = "mdbook-lint fix --config .mdbook-lint.toml {{ files }}"
  }
  ["server-compile"] = new Step {
    glob = List(
      "**/*.ex",
      "**/*.exs",
      "mix.exs",
      "mix.lock"
    )
    prefix = "mise x --"
    dir = "packages/server"
    check = "mix compile --warning-as-errors"
  }
  ["server-deps"] = new Step {
    glob = List("mix.exs", "mix.lock")
    prefix = "mise x --"
    dir = "packages/server"
    check = "mix deps.unlock --unused"
  }
  ["server-format"] = new Step {
    glob = List("**/*.ex", "**/*.exs", "**/*.heex")
    prefix = "mise x --"
    dir = "packages/server"
    check_diff = "mix format --check-formatted"
    fix = "mix format"
  }
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
    exclude = List("packages/server/**/*.ex", "packages/server/**/*.exs", "packages/server/**/*.heex")
  }
  ["go-fmt"] = new Step {
    glob = List("**/*.go")
    //check_first = false
    prefix = "mise x --"
    dir = "packages/client"
    check_diff = #"""
      sh -o errexit -o nounset -o pipefail -c '
        gofumpt -l . | (! grep .)
        goimports -l -local github.com/RobertDeRose/Nixstasis/packages/client . | (! grep .)
      '
      """#
    fix = #"""
      sh -o errexit -o nounset -o pipefail -c '
        gofumpt -l -w .
        goimports -w -local github.com/RobertDeRose/Nixstasis/packages/client .
      '
      """#
  }
  ["go-mod"] = new Step {
    glob = List("**/go.mod", "**/go.sum")
    prefix = "mise x -- sh -c"
    dir = "packages/client"
    check = "'go mod tidy && go mod verify'"
  }
  ["go-lint"] = new Step {
    glob = List("**/*.go", "**/go.mod", "**/go.sum", "**/.golangci.yml")
    prefix = "mise x -- sh -c"
    dir = "packages/client"
    check = "'golangci-lint run ./...'"
    fix = "'golangci-lint run --fix ./...'"
  }
}

local conformity = new Mapping<String, Step> {
  ["cocogitto_commit_msg"] = Builtins.cocogitto_commit_msg
  ["commit_message_beads"] = commit_message_beads
  ["commit_message_format"] = commit_message_validation
  ["commit_message_length"] = commit_message_length
  ["commit_message_scope"] = commit_message_scope
  ["harper_commit_message"] = harper_commit_message
}

default_branch = "dev"
exclude = List(
  "**/mermaid.min.js",
  "**/packages/server/assets/vendor/*"
)
fail_fast = false

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps = conformity
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
